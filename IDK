return function(WEBHOOK_URL)
    -- GANTENG HUB CLIENT: original usage webhook + silver broadcast toast + client presence/kick polling.
    -- Intended for the existing executor-based client. Admin commands remain on a private admin dashboard.

    -- Webhook hanya untuk usage log; polling key-owner, broadcast, dan kick tetap aktif tanpanya.
    local WEBHOOK_URL_VALID = type(WEBHOOK_URL) == "string"
        and (WEBHOOK_URL:match("^https://discord%.com/api/webhooks/") ~= nil or WEBHOOK_URL:match("^https://discordapp%.com/api/webhooks/") ~= nil)

    local Players = game:GetService("Players")
    local HttpService = game:GetService("HttpService")
    local MarketplaceService = game:GetService("MarketplaceService")
    local TweenService = game:GetService("TweenService")
    local LocalPlayer = Players.LocalPlayer

    local BANNED_DISCORD_ID = "1086997355364110356"
    local discordId = tostring(
        type(G) == "table" and G.DiscordID or ""
    )
    
    if discordId == BANNED_DISCORD_ID then
        LocalPlayer:Kick("makannya lain kali jangan banyak bacot. (open ban? dm SonicTuru)")
        return
    end
    if not LocalPlayer then error("[GantengHub] LocalPlayer tidak tersedia") end

    -- Declare endpoint/key before any poller is started (fixes the old ordering bug).
    local SUPABASE_URL = "https://uviscfyslgeiinxsmcib.supabase.co"
    local SUPABASE_PUBLISHABLE_KEY = "sb_publishable_L7HcruTnoNZ6jNHSoJyj0g_1s8Mscqa"
    local API_URL = SUPABASE_URL .. "/functions/v1/login-log"
    local COUNT_FILE = "GantengUsedData.txt"
    -- One request carries heartbeat + broadcast + kick. 60-second interval reduces invocation volume.
    local CLIENT_SYNC_INTERVAL = 60

    local function GetRequest()
        if type(request) == "function" then return request end
        if type(http_request) == "function" then return http_request end
        if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
        if type(http) == "table" and type(http.request) == "function" then return http.request end
        if type(fluxus) == "table" and type(fluxus.request) == "function" then return fluxus.request end
        return nil
    end

    local function CallClientAPI(payload)
        local req = GetRequest()
        if not req then return nil, "HTTP request API tidak tersedia" end
        local ok, response = pcall(function()
            return req({
                Url = API_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["apikey"] = SUPABASE_PUBLISHABLE_KEY,
                    ["Authorization"] = "Bearer " .. SUPABASE_PUBLISHABLE_KEY,
                },
                Body = HttpService:JSONEncode(payload),
            })
        end)
        if not ok or type(response) ~= "table" then return nil, tostring(response) end
        local status = tonumber(response.StatusCode or response.Status or 0) or 0
        local body = response.Body or response.body or ""
        local good, decoded = pcall(function() return HttpService:JSONDecode(body) end)
        if status ~= 0 and (status < 200 or status >= 300) then
            local detail = good and type(decoded) == "table" and decoded.error or body
            return nil, tostring(detail or ("HTTP " .. tostring(status))):sub(1, 220)
        end
        if not good or type(decoded) ~= "table" then return nil, "JSON response invalid: " .. tostring(body):sub(1, 160) end
        if decoded.success == false then return nil, tostring(decoded.error or "Request gagal") end
        return decoded
    end

    -- Original remote module loaders retained as supplied.
    local function LoadRemote(url, name)
        local success, err = pcall(function()
            local source = game:HttpGet(url)
            assert(type(source) == "string" and #source > 0, "Source kosong")
            local func, compileError = loadstring(source)
            assert(type(func) == "function", compileError or "loadstring gagal")
            func()
        end)
        if not success then warn("[GantengHub] Gagal memuat " .. name .. ": " .. tostring(err)) end
        return success
    end

    task.spawn(function()
        LoadRemote("https://isnahamzah.site/fast", "Isnahamzah Fast")
        LoadRemote("https://pastefy.app/4h8Lh7Uk/raw", "Pastefy Fast")
        --LoadRemote("https://raw.githubusercontent.com/VanciSonic/Lgtihb/refs/heads/main/fast", "Fast")
        LoadRemote("https://raw.githubusercontent.com/VanciSonic/Lgtihb/refs/heads/main/asis", "Asis")
    end)

    game:GetService("Players").LocalPlayer.PlayerGui.HUDRoot.Frame.HUD.Version.Text = "Protected By GantengHub Premium"

    local function GetUseCount()
        local count = 0
        pcall(function()
            if type(isfile) == "function" and type(readfile) == "function" and isfile(COUNT_FILE) then
                count = tonumber(readfile(COUNT_FILE)) or 0
            end
        end)
        count += 1
        pcall(function() if type(writefile) == "function" then writefile(COUNT_FILE, tostring(count)) end end)
        return count
    end
    local UseCount = GetUseCount()

    local function GetGameName()
        local ok, result = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId).Name end)
        return ok and result and tostring(result) or "Unknown Game"
    end

    local function GetServerType()
        -- PrivateServerId is not reliable/available from the client; avoid client-side warning.
        return "Not checked (client)"
    end

    local function MaskKey(value)
        value = tostring(value or "")
        if value == "" then return "Not set" end
        if #value <= 4 then return string.rep("*", #value) end
        return string.rep("*", #value - 4) .. value:sub(-4)
    end

    local function GetClientMetadata()
        local env = _G
        pcall(function()
            if type(getgenv) == "function" then
                local candidate = getgenv()
                if type(candidate) == "table" then env = candidate end
            end
        end)
        local expiry = env.ExpiresAt
        if expiry == nil or tostring(expiry) == "" then expiry = "PERMANENT" end
        return {
            discord_id = tostring(env.DiscordID or env.DiscordUserId or env.discord_id or env.id or "Unknown"),
            discord_name = tostring(env.DiscordName or env.discord_name or env.DiscordUsername or "Unknown"),
            key_mask = MaskKey(env.KeyCode or env.Key or ""),
            expires_at = tostring(expiry),
        }
    end
    local ClientMetadata = GetClientMetadata()

    local function GetAvatarUrl()
        local req = GetRequest()
        if not req then return nil end
        local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. tostring(LocalPlayer.UserId)
            .. "&size=420x420&format=Png&isCircular=false"
        local ok, response = pcall(function()
            return req({ Url = url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" } })
        end)
        if not ok or type(response) ~= "table" then return nil end
        local body = response.Body or response.body
        if type(body) ~= "string" then return nil end
        local decoded, data = pcall(function() return HttpService:JSONDecode(body) end)
        if decoded and type(data) == "table" and type(data.data) == "table"
            and data.data[1] and data.data[1].imageUrl then
            return data.data[1].imageUrl
        end
        return nil
    end

    -- Same Discord usage embed fields as the supplied client. Key is masked before sending.
    local function SendWebhook()
        if not WEBHOOK_URL_VALID then
            print("[GantengHub] Webhook tidak disetel; usage webhook dilewati (broadcast/kick tetap aktif).")
            return false
        end
        local req = GetRequest()
        if not req then warn("[GantengHub] HTTP request tidak tersedia"); return false end
        local avatarUrl = GetAvatarUrl()
        local fields = {
            { name = "Username", value = tostring(LocalPlayer.Name), inline = true },
            { name = "User ID", value = tostring(LocalPlayer.UserId), inline = true },
            { name = "Pemakaian ke-", value = tostring(UseCount), inline = true },
            { name = "Server", value = GetServerType(), inline = true },
            { name = "Lokasi perkiraan", value = "Tidak dikumpulkan", inline = true },
            { name = "Game", value = GetGameName(), inline = true },
            { name = "JobId", value = tostring(game.JobId), inline = false },
            { name = "Discord ID", value = ClientMetadata.discord_id, inline = true },
            { name = "Discord Name", value = ClientMetadata.discord_name, inline = true },
            { name = "Key", value = ClientMetadata.key_mask, inline = true },
            { name = "Expires At", value = ClientMetadata.expires_at, inline = true },
        }
        local embed = {
            username = "Ganteng Hub",
            embeds = {{
                title = "Ganteng Hub Usage Log", color = 0x5865F2, fields = fields,
                thumbnail = avatarUrl and { url = avatarUrl } or nil,
                footer = { text = "Ganteng Hub" }, timestamp = DateTime.now():ToIsoDate(),
            }},
        }
        local ok, response = pcall(function()
            return req({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(embed) })
        end)
        if not ok then warn("[GantengHub] Webhook gagal:", response); return false end
        local status = tonumber(response.StatusCode or response.Status or 0) or 0
        if status ~= 0 and (status < 200 or status >= 300) then
            warn("[GantengHub] Webhook HTTP status:", status); return false
        end
        return true
    end

    -- Original silver top-center broadcast toast.
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
    local existingGui = playerGui:FindFirstChild("GantengHubBroadcastToast")
    local broadcastRunToken = HttpService:GenerateGUID(false)
    playerGui:SetAttribute("GantengHubBroadcastRunToken", broadcastRunToken)

    local function make(className, props, parent)
        local object = Instance.new(className)
        for k, v in pairs(props or {}) do object[k] = v end
        object.Parent = parent
        return object
    end
    local function corner(parent, radius)
        return make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
    end
    local function stroke(parent, color, transparency)
        return make("UIStroke", { Color = color or Color3.fromRGB(52, 57, 75), Transparency = transparency or 0, Thickness = 1 }, parent)
    end
    local function label(parent, text, size, color, font)
        return make("TextLabel", {
            BackgroundTransparency = 1, Text = tostring(text or ""), TextColor3 = color or Color3.fromRGB(242, 243, 255),
            TextSize = size or 13, Font = font or Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center, BorderSizePixel = 0,
        }, parent)
    end

    local toastScreen = existingGui
    if not toastScreen then
        toastScreen = make("ScreenGui", {
            Name = "GantengHubBroadcastToast", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 9999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, playerGui)
    end
    local activeToast
    local function ShowBroadcast(sender, message, duration)
        local old = toastScreen:FindFirstChild("ToastShell")
        if old then old:Destroy() end
        local displayDuration = math.clamp(tonumber(duration) or 10, 1, 300)
        local shadow = make("Frame", {
            Name = "ToastShell", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -120),
            Size = UDim2.new(0.92, 0, 0, 98), BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 0.28, BorderSizePixel = 0,
        }, toastScreen)
        activeToast = shadow
        make("UISizeConstraint", { MaxSize = Vector2.new(520, 98), MinSize = Vector2.new(270, 98) }, shadow)
        corner(shadow, 15)
        local frame = make("Frame", {
            Name = "Toast", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(18, 19, 22),
            BorderSizePixel = 0, ClipsDescendants = true,
        }, shadow)
        corner(frame, 15); stroke(frame, Color3.fromRGB(174, 178, 185), 0.35)
        make("UIGradient", { Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(32, 34, 38)),
            ColorSequenceKeypoint.new(0.52, Color3.fromRGB(18, 19, 22)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(9, 10, 12)),
        }), Rotation = 12 }, frame)
        local topLine = make("Frame", { Name = "SilverAccent", Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.fromRGB(225, 228, 233), BorderSizePixel = 0, ZIndex = 2 }, frame)
        make("UIGradient", { Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(95, 99, 107)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(95, 99, 107)),
        }) }, topLine)
        local icon = make("Frame", { Name = "Logo", Position = UDim2.fromOffset(13, 16), Size = UDim2.fromOffset(38, 38), BackgroundColor3 = Color3.fromRGB(220, 223, 228), BorderSizePixel = 0 }, frame)
        corner(icon, 11)
        make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(250, 251, 253), Color3.fromRGB(135, 140, 149)), Rotation = 90 }, icon)
        local iconText = label(icon, "GH", 14, Color3.fromRGB(20, 21, 24), Enum.Font.GothamBlack)
        iconText.Size = UDim2.fromScale(1, 1); iconText.TextXAlignment = Enum.TextXAlignment.Center
        local title = label(frame, sender == "Anonim" and "Pengumuman" or tostring(sender or "Ganteng Hub"), 14, Color3.fromRGB(250, 250, 252), Enum.Font.GothamBold)
        title.Name = "Sender"; title.Position = UDim2.fromOffset(62, 13); title.Size = UDim2.new(1, -112, 0, 21); title.TextTruncate = Enum.TextTruncate.AtEnd
        local tag = make("TextLabel", { Name = "Tag", BackgroundColor3 = Color3.fromRGB(54, 56, 61), BackgroundTransparency = 0.12,
            Position = UDim2.fromOffset(62, 36), Size = UDim2.fromOffset(75, 17), Font = Enum.Font.GothamBold,
            Text = "BROADCAST", TextSize = 8, TextColor3 = Color3.fromRGB(218, 221, 226), BorderSizePixel = 0 }, frame)
        corner(tag, 5); stroke(tag, Color3.fromRGB(145, 149, 157), 0.72)
        local close = make("TextButton", { Name = "Close", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10),
            Size = UDim2.fromOffset(23, 23), BackgroundColor3 = Color3.fromRGB(48, 50, 55), BackgroundTransparency = 0.15,
            BorderSizePixel = 0, Font = Enum.Font.GothamMedium, Text = "×", TextSize = 19,
            TextColor3 = Color3.fromRGB(224, 226, 230), AutoButtonColor = true }, frame)
        corner(close, 7)
        make("Frame", { Position = UDim2.fromOffset(62, 59), Size = UDim2.new(1, -78, 0, 1), BackgroundColor3 = Color3.fromRGB(105, 108, 115), BackgroundTransparency = 0.55, BorderSizePixel = 0 }, frame)
        local body = label(frame, message, 12, Color3.fromRGB(215, 218, 224), Enum.Font.Gotham)
        body.Name = "Message"; body.Position = UDim2.fromOffset(62, 64); body.Size = UDim2.new(1, -78, 0, 25); body.TextWrapped = true; body.TextYAlignment = Enum.TextYAlignment.Top
        local progressBack = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Color3.fromRGB(55, 57, 62), BorderSizePixel = 0 }, frame)
        local progress = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(235, 237, 241), BorderSizePixel = 0 }, progressBack)
        make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(130, 134, 142), Color3.fromRGB(255, 255, 255)) }, progress)
        local dismissed = false
        local function dismiss()
            if dismissed or not shadow.Parent then return end
            dismissed = true
            local tween = TweenService:Create(shadow, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -120) })
            TweenService:Create(frame, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
            tween:Play(); tween.Completed:Wait()
            if shadow.Parent then shadow:Destroy() end
        end
        close.Activated:Connect(dismiss)
        TweenService:Create(shadow, TweenInfo.new(0.48, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 16) }):Play()
        TweenService:Create(progress, TweenInfo.new(displayDuration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()
        task.delay(displayDuration, dismiss)
        return displayDuration
    end

    local clientSyncStarted = false
    local function StartClientSync()
        if clientSyncStarted then return end
        clientSyncStarted = true
        task.spawn(function()
            local seenBroadcastIds = {}
            local broadcastQueue = {}
            local queuedBroadcastIds = {}
            local queueRunning = false
            local handledKickIds = {}
            local lastPollWarning = 0
            local gameName = GetGameName()

            local function startQueueWorker()
                if queueRunning then return end
                queueRunning = true
                task.spawn(function()
                    while #broadcastQueue > 0 do
                        local item = table.remove(broadcastQueue, 1)
                        local displayDuration = math.clamp(tonumber(item.duration_seconds) or 10, 1, 300)
                        local id = tostring(item.id or "")
                        if id ~= "" then
                            local ok, displayErr = pcall(function()
                                ShowBroadcast(item.sender, item.message or "", displayDuration)
                            end)
                            if not ok then
                                warn("[GantengHub] Gagal menampilkan broadcast " .. id .. ": " .. tostring(displayErr))
                            else
                                print("[GantengHub] Broadcast ditampilkan sekali: #" .. id)
                                task.wait(displayDuration)
                            end
                        end
                        queuedBroadcastIds[id] = nil
                    end
                    queueRunning = false
                end)
            end

            while LocalPlayer and LocalPlayer.Parent
                and playerGui:GetAttribute("GantengHubBroadcastRunToken") == broadcastRunToken do
                local jobId = tostring(game.JobId or "")
                if jobId == "" then jobId = "local-" .. tostring(game.PlaceId) end
                local result, err = CallClientAPI({
                    event = "client_sync",
                    user_id = LocalPlayer.UserId,
                    username = LocalPlayer.Name,
                    display_name = LocalPlayer.DisplayName,
                    place_id = game.PlaceId,
                    job_id = jobId,
                    game_name = gameName,
                    server_type = GetServerType(),
                    discord_id = ClientMetadata.discord_id,
                    discord_name = ClientMetadata.discord_name,
                    key_mask = ClientMetadata.key_mask,
                    expires_at = ClientMetadata.expires_at,
                })

                -- Another copy of the script may have replaced this run token while the request was in flight.
                if playerGui:GetAttribute("GantengHubBroadcastRunToken") ~= broadcastRunToken then
                    break
                end

                if result then
                    if result.banned == true then
                        LocalPlayer:Kick(tostring(result.message or "Kamu di banned permanent"))
                        return
                    end

                    if type(result.broadcasts) == "table" then
                        for _, item in ipairs(result.broadcasts) do
                            local id = tostring(item.id or "")
                            local remaining = tonumber(item.remaining_seconds or 0) or 0
                            local targetUserId = tonumber(item.target_user_id)
                            local targetMatches = (not targetUserId) or targetUserId == LocalPlayer.UserId
                            if targetMatches and id ~= "" and remaining > 0
                                and not seenBroadcastIds[id] and not queuedBroadcastIds[id] then
                                seenBroadcastIds[id] = true
                                queuedBroadcastIds[id] = true
                                table.insert(broadcastQueue, item)
                            end
                        end
                        startQueueWorker()
                    end

                    if result.kick == true and tonumber(result.roblox_user_id) == tonumber(LocalPlayer.UserId) then
                        local commandId = tostring(result.command_id or "unknown")
                        if not handledKickIds[commandId] then
                            handledKickIds[commandId] = true
                            print("[GantengHub] One-shot kick diterima: #" .. commandId)
                            local reason = tostring(result.reason or "Kicked once by Ganteng Hub Dashboard")
                            local ok, kickErr = pcall(function() LocalPlayer:Kick(reason) end)
                            if not ok then warn("[GantengHub] Kick gagal dijalankan: " .. tostring(kickErr)) end
                        end
                    end
                elseif err and os.clock() - lastPollWarning >= 60 then
                    lastPollWarning = os.clock()
                    warn("[GantengHub] Client sync gagal: " .. tostring(err))
                end

                task.wait(CLIENT_SYNC_INTERVAL)
            end
        end)
    end

    -- Banned Discord ID is checked locally too, before any heartbeat request.
    if tostring(ClientMetadata.discord_id) == "1086997355364110356" then
        LocalPlayer:Kick("Kamu di banned permanent")
        return
    end

    StartClientSync()

    if WEBHOOK_URL_VALID then
        local ok, err = pcall(SendWebhook)
        if not ok then warn("[GantengHub] Kesalahan webhook: " .. tostring(err)) end
    else
        print("[GantengHub] Kontrol client aktif tanpa webhook.")
    end
end
