    -- =========================================
    -- HTTP REQUEST
    -- =========================================

    local function GetRequest()
        if type(request) == "function" then
            return request
        end

        if type(http_request) == "function" then
            return http_request
        end

        if type(syn) == "table"
            and type(syn.request) == "function"
        then
            return syn.request
        end

        if type(http) == "table"
            and type(http.request) == "function"
        then
            return http.request
        end

        if type(fluxus) == "table"
            and type(fluxus.request) == "function"
        then
            return fluxus.request
        end

        return nil
    end

    -- =========================================
    -- USE COUNT
    -- =========================================

    local function GetUseCount()
        local count = 0

        pcall(function()
            if type(isfile) == "function"
                and type(readfile) == "function"
                and isfile(COUNT_FILE)
            then
                count = tonumber(readfile(COUNT_FILE)) or 0
            end
        end)

        count = count + 1

        pcall(function()
            if type(writefile) == "function" then
                writefile(COUNT_FILE, tostring(count))
            end
        end)

        return count
    end

    local UseCount = GetUseCount()

    -- =========================================
    -- GAME INFO
    -- =========================================

    local function GetGameName()
        local success, result = pcall(function()
            return MarketplaceService:GetProductInfo(game.PlaceId).Name
        end)

        if success and result then
            return tostring(result)
        end

        return "Unknown Game"
    end

    local function GetServerType()
        if game.PrivateServerId ~= "" then
            return "Private Server"
        end

        return "Public Server"
    end

    -- =========================================
    -- MASK KEY
    -- =========================================

    local function MaskKey(value)
        value = tostring(value or "")

        if value == "" then
            return "Not set"
        end

        if #value <= 4 then
            return string.rep("*", #value)
        end

        return string.rep("*", #value - 4) .. value:sub(-4)
    end

    -- =========================================
    -- CHARACTER AVATAR
    -- =========================================

    local function GetAvatarUrl()
        local req = GetRequest()

        if not req or not LocalPlayer then
            return nil
        end

        local url =
            "https://thumbnails.roblox.com/v1/users/avatar-headshot"
            .. "?userIds=" .. tostring(LocalPlayer.UserId)
            .. "&size=420x420&format=Png&isCircular=false"

        local success, response = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Mozilla/5.0"
                }
            })
        end)

        if not success or not response then
            return nil
        end

        local body = response.Body or response.body

        if type(body) ~= "string" then
            return nil
        end

        local decoded, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if decoded
            and type(data) == "table"
            and type(data.data) == "table"
            and data.data[1]
            and data.data[1].imageUrl
        then
            return data.data[1].imageUrl
        end

        return nil
    end

    -- =========================================
    -- DISCORD WEBHOOK
    -- =========================================

    local function SendWebhook()
        local req = GetRequest()

        if not req then
            warn("[GantengHub] HTTP request tidak tersedia")
            return false
        end

        -- Ambil metadata yang disediakan sistem key.
        local G = _G

        pcall(function()
            if type(getgenv) == "function" then
                local env = getgenv()

                if type(env) == "table" then
                    G = env
                end
            end
        end)

        local DiscordID = tostring(
            G.DiscordID or G.id or "Unknown"
        )

        local DiscordName = tostring(
            G.DiscordName or "Unknown"
        )

        local KeyValue = G.KeyCode or G.Key or ""
        local Expiry = G.ExpiresAt

        if Expiry == nil or tostring(Expiry) == "" then
            Expiry = "PERMANENT"
        else
            Expiry = tostring(Expiry)
        end

        local AvatarUrl = GetAvatarUrl()

        local Fields = {
            {
                name = "Username",
                value = tostring(LocalPlayer.Name),
                inline = true
            },
            {
                name = "User ID",
                value = tostring(LocalPlayer.UserId),
                inline = true
            },
            {
                name = "Pemakaian ke-",
                value = tostring(UseCount),
                inline = true
            },
            {
                name = "Server",
                value = GetServerType(),
                inline = true
            },
            {
                name = "Lokasi perkiraan",
                value = "Tidak dikumpulkan",
                inline = true
            },
            {
                name = "Game",
                value = GetGameName(),
                inline = true
            },
            {
                name = "JobId",
                value = tostring(game.JobId),
                inline = false
            },
            {
                name = "Discord ID",
                value = DiscordID,
                inline = true
            },
            {
                name = "Discord Name",
                value = DiscordName,
                inline = true
            },
            {
                name = "Key",
                value = MaskKey(KeyValue),
                inline = true
            },
            {
                name = "Expires At",
                value = Expiry,
                inline = true
            }
        }

        local Embed = {
            username = "Ganteng Hub",
            embeds = {{
                title = "Ganteng Hub Usage Log",
                color = 0x5865F2,
                fields = Fields,

                thumbnail = AvatarUrl and {
                    url = AvatarUrl
                } or nil,

                footer = {
                    text = "Ganteng Hub"
                },

                timestamp = DateTime.now():ToIsoDate()
            }}
        }

        local success, response = pcall(function()
            return req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(Embed)
            })
        end)

        if not success then
            warn("[GantengHub] Webhook gagal:", response)
            return false
        end

        local status = response.StatusCode or response.Status or 0

        if status ~= 0 and (status < 200 or status >= 300) then
            warn("[GantengHub] Webhook HTTP status:", status)
            return false
        end

        return true
    end

