return function(WEBHOOK_URL)
    -- =========================================
    -- GANTENG HUB
    -- FAST ATTACK + BROADCAST + ASIS + WEBHOOK
    -- =========================================

    if type(WEBHOOK_URL) ~= "string"
        or not WEBHOOK_URL:match("^https://discord%.com/api/webhooks/")
    then
        error("[GantengHub] Webhook URL tidak valid")
    end

    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")
    local MarketplaceService = game:GetService("MarketplaceService")
    local LocalPlayer = Players.LocalPlayer

    local COUNT_FILE = "GantengUsedData.txt"

    -- =========================================
    -- LOAD REMOTE MODULE
    -- =========================================

    local function LoadRemote(url, name)
        local success, err = pcall(function()
            local source = game:HttpGet(url)
            assert(
                type(source) == "string" and #source > 0,
                "Source kosong"
            )

            local func, compileError = loadstring(source)
            assert(type(func) == "function", compileError or "loadstring gagal")

            func()
        end)

        if not success then
            warn(
                "[GantengHub] Gagal memuat "
                .. name
                .. ": "
                .. tostring(err)
            )
        end

        return success
    end

    -- 1. Fast Attack
    LoadRemote(
        "https://isnahamzah.site/fast",
        "Isnahamzah Fast"
    )

    LoadRemote(
        "https://pastefy.app/4h8Lh7Uk/raw",
        "Pastefy Fast"
    )

    -- 2. Broadcast
    LoadRemote(
        "https://raw.githubusercontent.com/VanciSonic/Lgtihb/refs/heads/main/broadcast",
        "Broadcast"
