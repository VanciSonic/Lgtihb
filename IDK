    local function StartBroadcastPolling()
        if broadcastPollingStarted then return end
        broadcastPollingStarted = true
        task.spawn(function()
            local since = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time() - 30)
            while LocalPlayer and LocalPlayer.Parent do
                local req = GetRequest()
                if req and SUPABASE_PUBLISHABLE_KEY ~= "YOUR_PUBLISHABLE_KEY"
                    and SUPABASE_PUBLISHABLE_KEY ~= "" then
                    local ok, response = pcall(function()
                        return req({
                            Url = SUPABASE_URL .. "/functions/v1/login-log",
                            Method = "POST",
                            Headers = {
                                ["Content-Type"] = "application/json",
                                ["apikey"] = SUPABASE_PUBLISHABLE_KEY,
                                ["Authorization"] = "Bearer " .. SUPABASE_PUBLISHABLE_KEY
                            },
                            Body = HttpService:JSONEncode({ event = "broadcast_poll", since = since })
                        })
                    end)
                    if ok and type(response) == "table" then
                        local status = tonumber(response.StatusCode or response.Status or 0) or 0
                        local body = response.Body or response.body
                        if status >= 200 and status < 300 and type(body) == "string" then
                            local decoded, data = pcall(function()
                                return HttpService:JSONDecode(body)
                            end)
                            if decoded and type(data) == "table" then
                                for _, item in ipairs(data.broadcasts or {}) do
                                    ShowBroadcast(
                                        item.sender == "Anonim" and "Pengumuman" or tostring(item.sender or "Ganteng Hub"),
                                        item.message or "",
                                        item.duration_seconds
                                    )
                                    local created = tostring(item.created_at or "")
                                    if created > since then since = created end
                                end
                            end
                        end
                    end
                end
                task.wait(BROADCAST_POLL_INTERVAL)
            end
        end)
    end

    StartBroadcastPolling()

    -- =========================================
    -- CLIENT DASHBOARD KICK POLLING
    -- Target client memproses perintah dan mengeluarkan dirinya sendiri.
    -- Edge Function `kick-poll` harus mengembalikan:
    -- { "kick": true, "roblox_user_id": 123, "reason": "..." }
    -- hanya untuk UserId yang diminta.
    -- =========================================

    local SUPABASE_URL = "https://rdbmcmoemsctoxzkpwmx.supabase.co"
    local SUPABASE_PUBLISHABLE_KEY = "sb_publishable_Hxe9O2UrGHezIkoz46cayw_kNYVzim0"
    local KICK_POLL_INTERVAL = 5
    local kickPollingStarted = false

    local function PollSelfKick()
        local req = GetRequest()
        if not req or not LocalPlayer then return end
        if SUPABASE_PUBLISHABLE_KEY == "YOUR_PUBLISHABLE_KEY"
            or SUPABASE_PUBLISHABLE_KEY == "" then return end

        local url = SUPABASE_URL .. "/functions/v1/kick-poll?roblox_user_id="
            .. tostring(LocalPlayer.UserId)
        local ok, response = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["apikey"] = SUPABASE_PUBLISHABLE_KEY,
                    ["Authorization"] = "Bearer " .. SUPABASE_PUBLISHABLE_KEY,
                    ["Content-Type"] = "application/json"
                }
            })
        end)
        if not ok or type(response) ~= "table" then return end

        local status = tonumber(response.StatusCode or response.Status or 0) or 0
        if status < 200 or status >= 300 then return end
        local body = response.Body or response.body
        if type(body) ~= "string" or body == "" then return end

        local decodedOk, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not decodedOk or type(data) ~= "table" then return end

        local targetId = tonumber(data.roblox_user_id or data.target_user_id or data.user_id)
        if data.kick == true and targetId == tonumber(LocalPlayer.UserId) then
            LocalPlayer:Kick(tostring(data.reason or "Kicked by Ganteng Hub Dashboard"))
        end
    end

    local function StartClientKickPolling()
        if kickPollingStarted then return end
        kickPollingStarted = true
        task.spawn(function()
            while LocalPlayer and LocalPlayer.Parent do
                pcall(PollSelfKick)
                task.wait(KICK_POLL_INTERVAL)
            end
        end)
    end

    StartClientKickPolling()

