            --// Register normal Add* elements into the global search index.
            local function WrapSearchItem(methodName, getTitle)
                local original = Items[methodName]
                if type(original) ~= "function" then
                    return
                end

                Items[methodName] = function(self, config)
                    local targetOrder = CountItem
                    local result = original(self, config)

                    local targetFrame
                    for _, child in SectionAdd:GetChildren() do
                        if child:IsA("GuiObject") and child.LayoutOrder == targetOrder then
                            targetFrame = child
                            break
                        end
                    end

                    if targetFrame then
                        local title = getTitle(config)
                        if title and tostring(title) ~= "" then
                            KZN_SearchRegister(
                                title,
                                TabConfig.Name,
                                Title,
                                targetFrame,
                                function()
                                    if TabButton and TabButton.Parent then
                                        pcall(function()
                                            TabButton:Activate()
                                        end)
                                    end

                                    pcall(function()
                                        LayersPageLayout:JumpToIndex(Tab.LayoutOrder)
                                        NameTab.Text = TabConfig.Name
                                    end)

                                    task.wait(0.35)

                                    if not OpenSection then
                                        OpenSection = true
                                        UpdateSizeSection()
                                        task.wait(0.55)
                                    else
                                        task.wait(0.1)
                                    end

                                    if not targetFrame or not targetFrame.Parent then
                                        return
                                    end

                                    local currentY = targetFrame.AbsolutePosition.Y - ScrolLayers.AbsolutePosition.Y
                                    local targetY = ScrolLayers.CanvasPosition.Y + currentY - 8
                                    local maxY = math.max(0, ScrolLayers.AbsoluteCanvasSize.Y - ScrolLayers.AbsoluteWindowSize.Y)
                                    targetY = math.clamp(targetY, 0, maxY)
                                    ScrolLayers.CanvasPosition = Vector2.new(0, targetY)

                                    local oldHighlight = targetFrame:FindFirstChild("KZN_SearchHighlight")
                                    if oldHighlight then
                                        oldHighlight:Destroy()
                                    end

                                    local highlight = KZN_NewInstance("UIStroke")
                                    highlight.Name = "KZN_SearchHighlight"
                                    highlight.Color = GuiConfig.Color
                                    highlight.Thickness = 2
                                    highlight.Transparency = 0
                                    highlight.Parent = targetFrame

                                    TweenService:Create(highlight, TweenInfo.new(1.2), {
                                        Transparency = 1
                                    }):Play()

                                    task.delay(1.25, function()
                                        if highlight and highlight.Parent then
                                            highlight:Destroy()
                                        end
                                    end)
                                end
                            )
                        end
                    end

                    return result
                end
            end

            WrapSearchItem("AddParagraph", function(config)
                config = config or {}
                return config.Title or "Title"
            end)

            WrapSearchItem("AddPanel", function(config)
                config = config or {}
                return config.Title or "Title"
            end)

