-- ============================================================
-- INSTANCE CAPABILITY COMPATIBILITY
-- Some executor contexts expose Roblox Instances through a
-- restricted security reference. cloneref() gives the current
-- Luau thread a usable reference when the executor supports it.
-- Keep the fallback so normal Roblox/Luau environments still work.
-- ============================================================

local function KZN_NewInstance(className, parent)
    local obj = Instance.new(className)

    if type(cloneref) == "function" then
        local ok, ref = pcall(cloneref, obj)
        if ok and ref then
            obj = ref
        end

        if parent then
            local okParent, parentRef = pcall(cloneref, parent)
            if okParent and parentRef then
                parent = parentRef
            end
        end
    end

    if parent then
        local okParent = pcall(function()
            obj.Parent = parent
        end)
        if not okParent then
            return obj
        end
    end

    return obj
end

-- ============================================================
-- EXECUTOR THREAD IDENTITY RE-ASSERTION
-- Roblox can dispatch UI/input work onto a thread whose executor
-- identity/capability is different from the loader thread. Keep
-- the identity captured at library load and restore it before
-- engine-facing UI mutations.
-- ============================================================
local KZN_GetThreadIdentity = getthreadidentity or getidentity
local KZN_SetThreadIdentity = setthreadidentity or setidentity
local KZN_LoadIdentity = nil

if type(KZN_GetThreadIdentity) == "function" then
    pcall(function()
        KZN_LoadIdentity = KZN_GetThreadIdentity()
    end)
end

local function KZN_AssertThreadIdentity()
    if KZN_LoadIdentity ~= nil and type(KZN_SetThreadIdentity) == "function" then
        pcall(KZN_SetThreadIdentity, KZN_LoadIdentity)
    end
end

