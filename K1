            -- ------------------------------------------------
            -- Button
            -- ------------------------------------------------
            function Items:AddButton(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Confirm"
                cfg.Callback = cfg.Callback or function() end
                cfg.SubCallback = cfg.SubCallback or function() end

                local row = NewRow(34, cfg, true)

                local function Make(text, pos, size, cb)
                    local b = New("TextButton", {
                        Text = text, Font = FONT, TextSize = 12, TextColor3 = T.Text,
                        BackgroundColor3 = T.Control, BorderSizePixel = 0, AutoButtonColor = false,
                        Position = pos, Size = size,
                    }, row)
                    Corner(b, 10)
                    Hover(b, T.Control, T.Track)
                    b.Activated:Connect(function()
                        KZN_AssertThreadIdentity()
                        b.BackgroundColor3 = T.Text
                        b.TextColor3 = T.Dark
                        Tween(b, { BackgroundColor3 = T.Control, TextColor3 = T.Text }, 0.25)
                        SafeCall(cb)
                    end)
                    return b
                end

                local F = {}
                if cfg.SubTitle then
                    F.Button = Make(cfg.Title, UDim2.new(0, 0, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.Callback)
                    F.SubButton = Make(cfg.SubTitle, UDim2.new(0.5, 3, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.SubCallback)
                else
                    F.Button = Make(cfg.Title, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), cfg.Callback)
                end

                function F:Fire() SafeCall(cfg.Callback) end

                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Toggle
            -- ------------------------------------------------
            function Items:AddToggle(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Default = cfg.Default or false
                cfg.Callback = cfg.Callback or function() end

                local key = "Toggle_" .. cfg.Title
                local DefaultValue = cfg.Default
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                local Title = Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(1, -70, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(1, -70, 0, 16),
                    })
                end

                local Switch = New("Frame", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 34, 0, 18),
                }, row)
                Corner(Switch, 9)
                local Knob = New("Frame", {
                    BackgroundColor3 = Color3.fromRGB(190, 190, 190), BorderSizePixel = 0,
                    Position = UDim2.new(0, 3, 0, 3), Size = UDim2.new(0, 12, 0, 12),
                }, Switch)
                Corner(Knob, 6)

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                }, row)

                local F = { Value = cfg.Default }

                local function Visual()
                    if F.Value then
                        Tween(Switch, { BackgroundColor3 = GuiConfig.Color }, 0.2)
                        Tween(Knob, { Position = UDim2.new(0, 19, 0, 3), BackgroundColor3 = T.Dark }, 0.2)
                        Tween(Title, { TextColor3 = T.Text }, 0.2)
                    else
                        Tween(Switch, { BackgroundColor3 = T.Control }, 0.2)
                        Tween(Knob, { Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(190, 190, 190) }, 0.2)
                        Tween(Title, { TextColor3 = Color3.fromRGB(205, 205, 205) }, 0.2)
                    end
                end

                function F:Set(Value, silent)
                    F.Value = (Value == true)
                    ConfigData[key] = F.Value
                    Visual()
                    Sec.UpdateBadge()
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                Hit.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    F:Set(not F.Value)
                end)

                table.insert(Sec.Toggles, F)

                F:Set(F.Value, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                F.NoShare = (cfg.Share == false)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Guide (tutorial): tanda "??" -> klik -> popup panduan
            -- ------------------------------------------------
            -- Sec:AddGuide({
            --     Title = "Cara Farm Level", Content = "Tekan ?? untuk lihat panduan",
            --     GuideTitle = "Panduan Farm Level",
            --     GuideContent = "Langkah 1 ...\nLangkah 2 ...",            -- 1 halaman (rich text)
            --     Pages = { {Title="Langkah 1", Content="..."}, "teks saja" }, -- atau banyak halaman
            -- })
            function Items:AddGuide(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Guide"
                cfg.Content = cfg.Content or ""
                cfg.GuideTitle = cfg.GuideTitle or cfg.Title
                cfg.Callback = cfg.Callback or function() end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                local rich = (cfg.RichText ~= false)
                Label(row, {
                    Text = cfg.Title, TextSize = 12, RichText = rich,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(1, -70, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11, RichText = rich,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(1, -70, 0, 16),
                    })
                end

                local Badge = New("Frame", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 34, 0, 20),
                }, row)
                Corner(Badge, 10)
                local Mark = Label(Badge, {
                    Text = "??", Font = FONT_BOLD, TextSize = 11, TextColor3 = T.Sub,
                    TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None,
                    Size = UDim2.new(1, 0, 1, 0),
                })

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                }, row)
                Hit.MouseEnter:Connect(function()
                    Tween(Badge, { BackgroundColor3 = T.Text })
                    Tween(Mark, { TextColor3 = T.Dark })
                end)
                Hit.MouseLeave:Connect(function()
                    Tween(Badge, { BackgroundColor3 = T.Control })
                    Tween(Mark, { TextColor3 = T.Sub })
                end)

                local function GetPages()
                    local out = {}
                    if type(cfg.Pages) == "table" and #cfg.Pages > 0 then
                        for _, pg in ipairs(cfg.Pages) do
                            if type(pg) == "table" then
                                table.insert(out, { Title = pg.Title or cfg.GuideTitle, Content = pg.Content or "" })
                            else
                                table.insert(out, { Title = cfg.GuideTitle, Content = tostring(pg) })
                            end
                        end
                    else
                        table.insert(out, { Title = cfg.GuideTitle, Content = cfg.GuideContent or cfg.Content })
                    end
                    return out
                end

                local F = {}
                function F:Open()
                    ShowGuide({ Title = cfg.GuideTitle, Pages = GetPages() })
                    SafeCall(cfg.Callback)
                end
                function F:SetGuide(newCfg)
                    for k, v in pairs(newCfg or {}) do cfg[k] = v end
                end

                Hit.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    F:Open()
                end)

                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Slider
            -- ------------------------------------------------
            function Items:AddSlider(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Slider"
                cfg.Content = cfg.Content or ""
                cfg.Increment = cfg.Increment or 1
                cfg.Min = cfg.Min or 0
                cfg.Max = cfg.Max or 100
                cfg.Default = cfg.Default or 50
                cfg.Callback = cfg.Callback or function() end

                local key = "Slider_" .. cfg.Title
                local DefaultValue = cfg.Default
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                -- Angka di kanan bisa diklik lalu diketik (Enter / klik di luar untuk menerapkan)
                local ValueLabel = New("TextBox", {
                    Text = "", Font = FONT, TextSize = 11, TextColor3 = T.Sub,
                    TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false,
                    BackgroundColor3 = T.Control, BackgroundTransparency = 1, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.new(0, 40, 0, 20),
                }, row)
                Corner(ValueLabel, 6)
                Pad(ValueLabel, 4, 0, 6, 0)

                local Track = New("Frame", {
                    BackgroundColor3 = T.Track, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0),
                    Size = UDim2.new(0.42, 0, 0, 6),
                }, row)
                Corner(Track, 3)

                local Fill = New("Frame", {
                    BackgroundColor3 = GuiConfig.Color, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0),
                }, Track)
                Corner(Fill, 3)

                local Thumb = New("Frame", {
                    BackgroundColor3 = T.Text, BorderSizePixel = 0, ZIndex = 2,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12),
                }, Track)
                Corner(Thumb, 6)

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = UDim2.new(1, 12, 0, 24),
                }, Track)

                local F = { Value = cfg.Default, Min = cfg.Min, Max = cfg.Max, Increment = cfg.Increment }

                local function Visual()
                    local alpha = (F.Value - cfg.Min) / math.max(cfg.Max - cfg.Min, 1e-9)
                    alpha = math.clamp(alpha, 0, 1)
                    Fill.Size = UDim2.new(alpha, 0, 1, 0)
                    Thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
                    ValueLabel.Text = tostring(F.Value)
                end

                function F:Set(Value, silent)
                    Value = tonumber(Value) or cfg.Min
                    Value = math.clamp(RoundTo(Value - cfg.Min, cfg.Increment) + cfg.Min, cfg.Min, cfg.Max)
                    Value = math.floor(Value * 1000 + 0.5) / 1000
                    F.Value = Value
                    ConfigData[key] = Value
                    Visual()
                    if not silent then
                        SafeCall(cfg.Callback, Value)
                        SaveConfig()
                    end
                end

                -- input angka manual
                local typing = false
                ValueLabel.MouseEnter:Connect(function()
                    if not typing then Tween(ValueLabel, { BackgroundTransparency = 0.6 }) end
                end)
                ValueLabel.MouseLeave:Connect(function()
                    if not typing then Tween(ValueLabel, { BackgroundTransparency = 1 }) end
                end)
                ValueLabel.Focused:Connect(function()
                    typing = true
                    Tween(ValueLabel, { BackgroundTransparency = 0, TextColor3 = T.Text })
                end)
                ValueLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if not typing then return end
                    local cleaned = ValueLabel.Text:gsub("[^%d%.%-]", "")
                    if cleaned ~= ValueLabel.Text then
                        ValueLabel.Text = cleaned
                    end
                end)
                ValueLabel.FocusLost:Connect(function()
                    typing = false
                    Tween(ValueLabel, { BackgroundTransparency = 1, TextColor3 = T.Sub })
                    local num = tonumber(ValueLabel.Text)
                    if num then
                        F:Set(num)
                    else
                        Visual()
                    end
                end)

                local dragging = false
                local function UpdateFromInput(input)
                    local rel = (input.Position.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1)
                    rel = math.clamp(rel, 0, 1)
                    local v = cfg.Min + (cfg.Max - cfg.Min) * rel
                    if RoundTo(v - cfg.Min, cfg.Increment) + cfg.Min ~= F.Value then
                        F:Set(v)
                    end
                end

                Hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        SaveConfig()
                    end
                end)

                F:Set(F.Value, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                F.NoShare = (cfg.Share == false)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Input
            -- ------------------------------------------------
            function Items:AddInput(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Callback = cfg.Callback or function() end
                cfg.Default = cfg.Default or ""

                local key = "Input_" .. cfg.Title
                local DefaultValue = cfg.Default
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local Box = New("TextBox", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ClearTextOnFocus = false,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = "",
                    PlaceholderText = cfg.Placeholder or "Ketik di sini", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0.52, -10, 0, 24),
                }, row)
                Corner(Box, 8)
                Pad(Box, 10, 0, 10, 0)

                local F = { Value = cfg.Default }

                function F:Set(Value, silent)
                    F.Value = tostring(Value or "")
                    Box.Text = F.Value
                    ConfigData[key] = F.Value
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                Box.FocusLost:Connect(function()
                    if Box.Text ~= F.Value then
                        F:Set(Box.Text)
                    end
                end)

                F:Set(F.Value, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                F.NoShare = (cfg.Share ~= true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Panel (input + tombol)
            -- ------------------------------------------------
            function Items:AddPanel(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Default = cfg.Default or ""
                cfg.ButtonText = cfg.Button or cfg.ButtonText or "Confirm"
                cfg.ButtonCallback = cfg.Callback or cfg.ButtonCallback or function() end
                cfg.SubButtonText = cfg.SubButton or cfg.SubButtonText or nil
                cfg.SubButtonCallback = cfg.SubCallback or cfg.SubButtonCallback or function() end

                local key = "Panel_" .. cfg.Title
                local DefaultValue = cfg.Default
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local row = NewRow(110, cfg)
                row.AutomaticSize = Enum.AutomaticSize.Y
                row.Size = UDim2.new(1, 0, 0, 0)
                Pad(row, 10, 10, 10, 10)
                New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, row)

                Label(row, {
                    Text = cfg.Title, Font = FONT_BOLD, TextSize = 12, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1,
                })
                if cfg.Content ~= "" then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11, TextWrapped = true,
                        TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
                        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
                        RichText = (cfg.RichText ~= false),
                    })
                end

                local Box = New("TextBox", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ClearTextOnFocus = false,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = cfg.Default,
                    PlaceholderText = cfg.Placeholder or "Ketik di sini", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 3,
                }, row)
                Corner(Box, 8)
                Pad(Box, 10, 0, 10, 0)

                Box.FocusLost:Connect(function()
                    ConfigData[key] = Box.Text
                    SaveConfig()
                end)

                local Buttons = New("Frame", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 4,
                }, row)

                local function Make(text, pos, size, cb)
                    local b = New("TextButton", {
                        Text = text, Font = FONT, TextSize = 12, TextColor3 = T.Text,
                        BackgroundColor3 = T.Control, BorderSizePixel = 0, AutoButtonColor = false,
                        Position = pos, Size = size,
                    }, Buttons)
                    Corner(b, 8)
                    Hover(b, T.Control, T.Track)
                    b.Activated:Connect(function()
                        KZN_AssertThreadIdentity()
                        SafeCall(cb, Box.Text)
                    end)
                    return b
                end

                if cfg.SubButtonText then
                    Make(cfg.ButtonText, UDim2.new(0, 0, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.ButtonCallback)
                    Make(cfg.SubButtonText, UDim2.new(0.5, 3, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.SubButtonCallback)
                else
                    Make(cfg.ButtonText, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), cfg.ButtonCallback)
                end

                local F = {}
                function F:GetInput() return Box.Text end
                function F:Set(Value, silent)
                    Box.Text = tostring(Value or "")
                    ConfigData[key] = Box.Text
                    if not silent then SaveConfig() end
                end

                F.DefaultValue = DefaultValue
                F.Resettable = true
                F.NoShare = (cfg.Share ~= true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Dropdown
            -- ------------------------------------------------
            function Items:AddDropdown(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Multi = cfg.Multi or false
                cfg.Options = cfg.Options or {}
                cfg.Default = cfg.Default or (cfg.Multi and {} or nil)
                cfg.Callback = cfg.Callback or function() end

                local key = "Dropdown_" .. cfg.Title
                local DefaultValue = cfg.Default
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local Pill = New("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0.52, -10, 0, 24),
                }, row)
                Corner(Pill, 8)
                Hover(Pill, T.Control, T.Track)

                local PillText = Label(Pill, {
                    Text = "", TextColor3 = Color3.fromRGB(205, 205, 205), TextSize = 11,
                    Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -30, 1, 0),
                })

                -- Panah chevron (digambar dari Frame): kanan = tertutup, bawah = terbuka
                local Chevron = New("Frame", {
                    BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.new(0, 10, 0, 10), Rotation = -90,
                }, Pill)
                for _, d in ipairs({ { 3.1, 45 }, { 6.9, -45 } }) do
                    local bar = New("Frame", {
                        BackgroundColor3 = T.Sub, BorderSizePixel = 0,
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, d[1], 0, 5),
                        Size = UDim2.new(0, 6, 0, 2), Rotation = d[2],
                    }, Chevron)
                    Corner(bar, 1)
                end

                local HEADER = 38

                local Popup = New("Frame", {
                    Name = "DropdownPopup", BackgroundColor3 = T.Popup, BorderSizePixel = 0,
                    Visible = false, ZIndex = 60, ClipsDescendants = true, Size = UDim2.new(0, 150, 0, 0),
                }, Main)
                Corner(Popup, 12)

                local SearchWrap = New("Frame", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ZIndex = 61,
                    Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 26),
                }, Popup)
                Corner(SearchWrap, 8)

                local SearchInput = New("TextBox", {
                    BackgroundTransparency = 1, ClearTextOnFocus = false, ZIndex = 62,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = "",
                    PlaceholderText = "Cari...", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0),
                }, SearchWrap)

                local List = New("ScrollingFrame", {
                    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 61,
                    Position = UDim2.new(0, 4, 0, HEADER), Size = UDim2.new(1, -8, 1, -(HEADER + 4)),
                    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(120, 120, 120), Active = true,
                }, Popup)
                New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, List)

                local EmptyLabel = Label(List, {
                    Text = "Tidak ditemukan", TextColor3 = T.Muted, TextSize = 11, ZIndex = 62,
                    TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -6, 0, 26),
                    LayoutOrder = 99999, Visible = false,
                })

                -- Daftar pilihan bawaan script (tidak berubah walau list diisi ulang saat runtime).
                -- Dipakai share code supaya pilihan bisa dipadatkan jadi hash dan tetap 100% cocok di device lain.
                local StaticOptions = {}
                for i, o in ipairs(cfg.Options) do StaticOptions[i] = o end

                local F = { Value = cfg.Multi and {} or nil, Options = cfg.Options, StaticOptions = StaticOptions, Opened = false }
                local OptionButtons = {}
                local openUp = false
                local animToken = 0

                local function IsSelected(opt)
                    if cfg.Multi then
                        return type(F.Value) == "table" and IndexOf(F.Value, opt) ~= nil
                    end
                    return F.Value == opt
                end

                local function Display()
                    if cfg.Multi then
                        local t = (type(F.Value) == "table") and F.Value or {}
                        PillText.Text = (#t > 0) and table.concat(t, ", ") or "Pilih"
                    else
                        PillText.Text = (F.Value ~= nil) and tostring(F.Value) or "Pilih"
                    end
                end

                local function Styles()
                    for opt, b in pairs(OptionButtons) do
                        local on = IsSelected(opt)
                        b.BackgroundColor3 = on and Color3.fromRGB(230, 230, 230) or T.Popup
                        b.TextColor3 = on and T.Dark or Color3.fromRGB(205, 205, 205)
                    end
                end

                local function TargetRect()
                    local count = 0
                    for _, b in pairs(OptionButtons) do
                        if b.Visible then count = count + 1 end
                    end
                    if count == 0 then count = 1 end

                    local width = math.max(Pill.AbsoluteSize.X, 170)
                    local height = math.min(count * 28 + 8, 172) + HEADER
                    local p = Pill.AbsolutePosition - Main.AbsolutePosition
                    local x = p.X + Pill.AbsoluteSize.X - width
                    local below = p.Y + Pill.AbsoluteSize.Y + 4
                    local y = below

                    openUp = (below + height > Main.AbsoluteSize.Y - 8)
                    if openUp then y = p.Y - height - 4 end

                    x = math.clamp(x, 8, math.max(8, Main.AbsoluteSize.X - width - 8))
                    y = math.max(y, 8)
                    return x, y, width, height
                end

                local function ApplyFilter()
                    local q = Normalize(SearchInput.Text)
                    local shown = 0
                    for opt, b in pairs(OptionButtons) do
                        local ok = (q == "") or (string.find(string.lower(tostring(opt)), q, 1, true) ~= nil)
                        b.Visible = ok
                        if ok then shown = shown + 1 end
                    end
                    EmptyLabel.Visible = (shown == 0)
                    List.CanvasPosition = Vector2.new(0, 0)

                    if F.Opened then
                        local x, y, w, h = TargetRect()
                        Tween(Popup, { Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y) }, 0.12)
                    end
                end

                SearchInput:GetPropertyChangedSignal("Text"):Connect(ApplyFilter)

                local function Close()
                    if not F.Opened then return end
                    F.Opened = false
                    if ClosePopup == F.CloseFn then ClosePopup = nil end

                    animToken = animToken + 1
                    local token = animToken
                    SearchInput:ReleaseFocus()
                    Tween(Chevron, { Rotation = -90 }, 0.18)

                    -- menyusut / tersedot kembali ke tombol dropdown
                    local w, h = Popup.AbsoluteSize.X, Popup.AbsoluteSize.Y
                    local px, py = Popup.Position.X.Offset, Popup.Position.Y.Offset
                    local endY = openUp and (py + h) or py
                    local tw = Tween(Popup, { Size = UDim2.new(0, w, 0, 0), Position = UDim2.new(0, px, 0, endY) }, 0.16)
                    tw.Completed:Connect(function()
                        if animToken == token then Popup.Visible = false end
                    end)
                end

                F.CloseFn = function(pos)
                    if pos then
                        local function inside(gui)
                            local p, s = gui.AbsolutePosition, gui.AbsoluteSize
                            return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
                        end
                        if inside(Popup) or inside(Pill) then return end
                    end
                    Close()
                end

                function F:Set(Value, silent)
                    if cfg.Multi then
                        local copy = {}
                        if type(Value) == "table" then
                            for _, v in ipairs(Value) do table.insert(copy, v) end
                        end
                        Value = copy
                    end
                    F.Value = Value
                    ConfigData[key] = Value
                    Styles()
                    Display()
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                local function Rebuild()
                    for _, c in ipairs(List:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    OptionButtons = {}

                    for i, opt in ipairs(F.Options) do
                        local b = New("TextButton", {
                            Text = tostring(opt), Font = FONT, TextSize = 11, TextColor3 = T.Text,
                            BackgroundColor3 = T.Popup, BorderSizePixel = 0, AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 62,
                            Size = UDim2.new(1, -6, 0, 26), LayoutOrder = i,
                        }, List)
                        Corner(b, 8)
                        Pad(b, 10, 0, 6, 0)
                        OptionButtons[opt] = b

                        b.Activated:Connect(function()
                            KZN_AssertThreadIdentity()
                            if cfg.Multi then
                                local cur = {}
                                for _, v in ipairs(type(F.Value) == "table" and F.Value or {}) do
                                    table.insert(cur, v)
                                end
                                local idx = IndexOf(cur, opt)
                                if idx then table.remove(cur, idx) else table.insert(cur, opt) end
                                F:Set(cur)
                            else
                                F:Set(opt)
                                Close()
                            end
                        end)
                    end

                    Styles()
                    if Normalize(SearchInput.Text) ~= "" then ApplyFilter() else EmptyLabel.Visible = (#F.Options == 0) end
                end

                local function Open()
                    if ClosePopup then ClosePopup() end

                    SearchInput.Text = ""
                    ApplyFilter()

                    animToken = animToken + 1
                    local x, y, w, h = TargetRect()
                    local startY = openUp and (y + h) or y

                    Popup.Size = UDim2.new(0, w, 0, 0)
                    Popup.Position = UDim2.new(0, x, 0, startY)
                    Popup.Visible = true
                    Tween(Popup, { Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y) }, 0.2)
                    Tween(Chevron, { Rotation = 0 }, 0.2)

                    F.Opened = true
                    ClosePopup = F.CloseFn

                    if not UserInputService.TouchEnabled then
                        task.defer(function()
                            if F.Opened then SearchInput:CaptureFocus() end
                        end)
                    end
                end

                Pill.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    if F.Opened then Close() else Open() end
                end)

                function F:Clear()
                    F.Options = {}
                    F.Value = cfg.Multi and {} or nil
                    ConfigData[key] = F.Value
                    Rebuild()
                    Display()
                end

                function F:AddOption(option)
                    table.insert(F.Options, option)
                    Rebuild()
                end

                function F:SetValues(newList, selecting, silent)
                    F.Options = newList or {}
                    Rebuild()
                    F:Set(selecting, silent)
                end

                function F:SetValue(val) F:Set(val) end
                function F:GetValue() return F.Value end

                F:SetValues(F.Options, cfg.Default, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                F.NoShare = (cfg.Share == false)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Share Panel: Export / Import code seluruh setting
            -- ------------------------------------------------
            -- Sec:AddSharePanel()   (opsional: { Title = "...", Content = "...", Column = 1 })
            function Items:AddSharePanel(cfg)
                cfg = cfg or {}
                local GREEN = Color3.fromRGB(70, 220, 120)
                local panel

                panel = Items:AddPanel({
                    Title = cfg.Title or "Share Config",
                    Content = cfg.Content or "Export = salin code seluruh setting kamu. Import = tempel code dari orang lain lalu tekan Import Code.",
                    Placeholder = SHARE_PREFIX .. "...",
                    Button = "Import Code",
                    SubButton = "Export Code",
                    Column = cfg.Column,
                    Callback = function(text)
                        local ok, res, mismatch = RcHub:ImportCode(text)
                        if ok then
                            RcHub:MakeNotify({
                                Title = BRAND_NAME, Description = "Import berhasil", Color = GREEN, Delay = 4,
                                Content = tostring(res) .. " element di-load dari code."
                                    .. (mismatch and "\nCode dibuat di versi script yang beda, sebagian element mungkin tidak cocok." or ""),
                            })
                        else
                            RcHub:MakeNotify({
                                Title = BRAND_NAME, Description = "Import gagal", Color = COLOR_RED, Delay = 4,
                                Content = tostring(res),
                            })
                        end
                    end,
                    SubCallback = function()
                        local code, info = RcHub:ExportCode()
                        if not code then
                            RcHub:MakeNotify({
                                Title = BRAND_NAME, Description = "Export gagal", Color = COLOR_RED, Delay = 4,
                                Content = tostring(info),
                            })
                            return
                        end

                        local clip = setclipboard or toclipboard
                        local copied = false
                        if type(clip) == "function" then
                            copied = pcall(clip, code)
                        end
                        if not copied then
                            panel:Set(code, true) -- fallback: taruh di kotak input, salin manual
                        end

                        RcHub:MakeNotify({
                            Title = BRAND_NAME, Description = "Export berhasil", Color = GREEN, Delay = 5,
                            Content = copied
                                and ("Code disalin ke clipboard (" .. #code .. " karakter).")
                                or "Executor tidak punya clipboard, code ditaruh di kotak input. Salin manual.",
                        })
                    end,
                })
                return panel
            end

            return Items
        end

        local safeName = TabConfig.Name:gsub("%s+", "_")
        _G[safeName] = Sections
        return Sections
    end

    return Tabs
end

return RcHub
