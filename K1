            local function UpdateSizeScroll()
                local OffsetY = 0
                for _, child in ScrolLayers:GetChildren() do
                    if child.Name ~= "UIListLayout" then
                        OffsetY = OffsetY + 3 + child.Size.Y.Offset
                    end
                end
                ScrolLayers.CanvasSize = UDim2.new(0, 0, 0, OffsetY)
            end

            local function GetSectionContentHeight()
                local contentHeight = 0
                local itemCount = 0

                for _, v in SectionAdd:GetChildren() do
                    if v.Name ~= "UIListLayout" and v.Name ~= "UICorner" then
                        contentHeight = contentHeight + v.Size.Y.Offset
                        itemCount = itemCount + 1
                    end
                end

                if itemCount > 0 then
                    contentHeight = contentHeight + ((itemCount - 1) * 3)
                end

                return contentHeight
            end

            -- Refresh the section immediately after an Add* function has
            -- finished constructing its element. This avoids the original
            -- bug where ChildAdded fired while the new element still had
            -- its default size, leaving the section too small until the
            -- user manually collapsed and reopened it.
            local function RefreshSectionSize()
                if not OpenSection then
                    return
                end

                local contentHeight = GetSectionContentHeight()
                local totalHeight = 38 + contentHeight

                if FeatureFrame and FeatureFrame.Parent then
                    FeatureFrame.Rotation = 90
                end

                Section.Size = UDim2.new(1, 1, 0, totalHeight)
                SectionAdd.Size = UDim2.new(1, 0, 0, contentHeight)
                SectionDecideFrame.Size = UDim2.new(1, 0, 0, 2)
                UpdateSizeScroll()
            end

            local function UpdateSizeSection()
                if not OpenSection then
                    return
                end

                local contentHeight = GetSectionContentHeight()
                local totalHeight = 38 + contentHeight

                if FeatureFrame and FeatureFrame.Parent then
                    TweenService:Create(FeatureFrame, TweenInfo.new(0.5), { Rotation = 90 }):Play()
                end
                TweenService:Create(Section, TweenInfo.new(0.5), {
                    Size = UDim2.new(1, 1, 0, totalHeight)
                }):Play()
                TweenService:Create(SectionAdd, TweenInfo.new(0.5), {
                    Size = UDim2.new(1, 0, 0, contentHeight)
                }):Play()
                TweenService:Create(SectionDecideFrame, TweenInfo.new(0.5), {
                    Size = UDim2.new(1, 0, 0, 2)
                }):Play()

                task.delay(0.5, UpdateSizeScroll)
            end

            if AlwaysOpen == true then
                SectionButton:Destroy()
                FeatureFrame:Destroy()
                OpenSection = true
            elseif AlwaysOpen == false then
                -- false = start expanded, but remain collapsible.
                -- Do not calculate/tween here because Add* elements have
                -- not been created yet. Each Add* performs a final refresh.
                OpenSection = true
            else
                OpenSection = false
            end

            if AlwaysOpen ~= true then
                SectionButton.Activated:Connect(function()
                    CircleClick(SectionButton, Mouse.X, Mouse.Y)
                    if OpenSection then
                        TweenService:Create(FeatureFrame, TweenInfo.new(0.5), { Rotation = 0 }):Play()
                        TweenService:Create(Section, TweenInfo.new(0.5), { Size = UDim2.new(1, 1, 0, 30) }):Play()
                        TweenService:Create(SectionDecideFrame, TweenInfo.new(0.5), { Size = UDim2.new(0, 0, 0, 2) })
                            :Play()
                        OpenSection = false
                        task.wait(0.5)
                        UpdateSizeScroll()
                    else
                        OpenSection = true
                        UpdateSizeSection()
                    end
                end)
            end

            if AlwaysOpen == true or AlwaysOpen == false then
                OpenSection = true
                -- Initial shell only. The actual content height is applied
                -- by RefreshSectionSize() after each Add* finishes.
                if FeatureFrame and FeatureFrame.Parent then
                    FeatureFrame.Rotation = 90
                end
                Section.Size = UDim2.new(1, 1, 0, 38)
                SectionAdd.Size = UDim2.new(1, 0, 0, 0)
                SectionDecideFrame.Size = UDim2.new(1, 0, 0, 2)
            end

            -- Do NOT use SectionAdd.ChildAdded here. ChildAdded fires as soon
            -- as an Instance is parented, before AddToggle/AddDropdown/etc.
            -- finish assigning Size. That was the cause of the original
            -- startup compression bug.

            local layout = ScrolLayers:FindFirstChildOfClass("UIListLayout")
            if layout then
                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
