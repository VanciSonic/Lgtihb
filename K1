local function KZN_DecodeBase64(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, #alphabet do
        map[alphabet:sub(i, i)] = i - 1
    end
    data = data:gsub("[^A-Za-z0-9%+/=]", "")
    local out = {}
    for i = 1, #data, 4 do
        local a = map[data:sub(i, i)] or 0
        local b = map[data:sub(i + 1, i + 1)] or 0
        local cChar = data:sub(i + 2, i + 2)
        local dChar = data:sub(i + 3, i + 3)
        local c = map[cChar] or 0
        local d = map[dChar] or 0
        out[#out + 1] = string.char(bit32.bor(bit32.lshift(a, 2), bit32.rshift(b, 4)))
        if cChar and cChar ~= "=" and #cChar == 1 then
            out[#out + 1] = string.char(bit32.bor(bit32.lshift(bit32.band(b, 15), 4), bit32.rshift(c, 2)))
        end
        if dChar and dChar ~= "=" and #dChar == 1 then
            out[#out + 1] = string.char(bit32.bor(bit32.lshift(bit32.band(c, 3), 6), d))
        end
    end
    return table.concat(out)
end

local function KZN_GetRedEyeAsset()
    local path = "KZN/RedEyeSprite_1600x1080_10fps.jpg"
    local ok, asset = pcall(function()
        if not isfile or not isfile(path) then
            if not writefile then error("writefile is unavailable") end
            writefile(path, KZN_DecodeBase64(KZN_REDEYE_B64))
        end
        local getter = getcustomasset or getsynasset
        if type(getter) ~= "function" then error("getcustomasset is unavailable") end
        return getter(path)
    end)
    if ok then return asset end
    warn("[KaizenUI] Animated background unavailable: " .. tostring(asset))
    return nil
end


