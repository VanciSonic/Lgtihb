    local SearchItems = {}

    local function Normalize(s)
        return string.lower((tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")))
    end

    local function SearchRegister(title, tabName, sectionName, frame, focus)
        local clean = (tostring(title):gsub("<[^>]+>", ""))
        table.insert(SearchItems, {
            Title = clean, Norm = Normalize(clean),
            Tab = tabName, Section = sectionName, Frame = frame, Focus = focus,
        })
    end

    local function SearchClear()
        for _, c in ipairs(SearchScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        SearchResults.Visible = false
    end

    local function SearchShow(text)
        local q = Normalize(text)
        if q == "" then
            SearchClear()
            return
        end

        for _, c in ipairs(SearchScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        local count = 0
        for _, item in ipairs(SearchItems) do
            if item.Frame and item.Frame.Parent and string.find(item.Norm, q, 1, true) then
                count = count + 1
                if count > 40 then break end

                local Result = New("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = T.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 40), LayoutOrder = count, ZIndex = 42,
                }, SearchScroll)
                Corner(Result, 10)

                Label(Result, {
                    Text = item.Title, Font = FONT_BOLD, TextSize = 12, ZIndex = 43,
                    Position = UDim2.new(0, 12, 0, 5), Size = UDim2.new(1, -40, 0, 16),
                })
                Label(Result, {
                    Text = tostring(item.Tab) .. "  ›  " .. tostring(item.Section),
                    TextColor3 = T.Muted, TextSize = 10, ZIndex = 43,
                    Position = UDim2.new(0, 12, 0, 21), Size = UDim2.new(1, -40, 0, 13),
                })
                Label(Result, {
                    Text = "›", Font = FONT_BOLD, TextSize = 16, TextColor3 = T.Sub, ZIndex = 43,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.new(0, 16, 0, 20),
                })

                Result.MouseEnter:Connect(function() Tween(Result, { BackgroundColor3 = T.Control }) end)
                Result.MouseLeave:Connect(function() Tween(Result, { BackgroundColor3 = T.Row }) end)
                Result.Activated:Connect(function()
                    SearchBox.Text = ""
                    SearchClear()
                    SearchBox:ReleaseFocus()
                    if item.Focus then
                        task.spawn(item.Focus)
                    end
                end)
            end
        end

        if count == 0 then
            Label(SearchScroll, {
                Text = "Element tidak ditemukan", TextColor3 = T.Muted, TextSize = 12, ZIndex = 42,
                TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40),
            })
        end

        SearchResults.Visible = true
        SearchScroll.CanvasPosition = Vector2.new(0, 0)
    end

