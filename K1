local function DeleteFolder(path)
    if not hasFS then return end

    if type(listfiles) == "function" and type(delfile) == "function" then
        local function ClearContents(folder)
            local ok, entries = pcall(listfiles, folder)
            if not ok or type(entries) ~= "table" then return end

            for _, entry in ipairs(entries) do
                local item = tostring(entry)
                local isDir = false
                pcall(function() isDir = isfolder(item) end)
                if isDir then
                    ClearContents(item)
                    if type(delfolder) == "function" then pcall(delfolder, item) end
                else
                    pcall(delfile, item)
                end
            end
        end
        ClearContents(path)
    elseif type(delfile) == "function" and isfile(ConfigFile) then
        pcall(delfile, ConfigFile)
    end

    if type(delfolder) == "function" then
        pcall(delfolder, path)
    end
end

ConfigData      = {}
Elements        = {}
CURRENT_VERSION = nil

local _saveScheduled = false
function SaveConfig()
    if not hasFS or _resettingConfig then return end
    if _saveScheduled then return end
    _saveScheduled = true
    local generation = _saveGeneration
    task.delay(0.75, function()
        if generation ~= _saveGeneration then return end
        _saveScheduled = false
        if _resettingConfig then return end
        ConfigData._version = CURRENT_VERSION
        pcall(function()
            EnsureConfigFolders()
            writefile(ConfigFile, HttpService:JSONEncode(ConfigData))
        end)
    end)
end

function SaveConfigNow()
    if not hasFS or _resettingConfig then return end
    _saveScheduled = false
    ConfigData._version = CURRENT_VERSION
    pcall(function()
        EnsureConfigFolders()
        writefile(ConfigFile, HttpService:JSONEncode(ConfigData))
    end)
end

function LoadConfigFromFile()
    if not CURRENT_VERSION then return end
    if hasFS and isfile(ConfigFile) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigFile))
        end)
        if success and type(result) == "table" and result._version == CURRENT_VERSION then
            ConfigData = result
        else
            ConfigData = { _version = CURRENT_VERSION }
        end
    else
        ConfigData = { _version = CURRENT_VERSION }
    end
end

function LoadConfigElements()
    for key, element in pairs(Elements) do
        if ConfigData[key] ~= nil and element.Set then
            element:Set(ConfigData[key], true)
        end
    end
end

