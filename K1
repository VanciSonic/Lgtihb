        query = KZN_SearchNormalize(query)
        if query == "" then
            KZN_SearchClearResults()
            return
        end

        if not SearchResultScroll or not SearchResults then
            return
        end

        for _, child in SearchResultScroll:GetChildren() do
            if child.Name ~= "SearchResultLayout" then
                child:Destroy()
            end
        end

        local resultCount = 0
        local maxResults = 50
        for _, item in ipairs(SearchItems) do
            local found = string.find(item.SearchTitle, query, 1, true)
                or string.find(item.SearchSection, query, 1, true)
