function RcHub:Window(GuiConfig)
    KZN_AssertThreadIdentity()
    GuiConfig              = GuiConfig or {}
    GuiConfig.Title        = BRAND_NAME
    GuiConfig.Footer       = BRAND_TAG
    GuiConfig.Color        = GuiConfig.Color or T.Text
    GuiConfig["Tab Width"] = math.max(GuiConfig["Tab Width"] or 150, 120)
    GuiConfig.Version      = GuiConfig.Version or 1
    GuiConfig.ToggleKey    = GuiConfig.ToggleKey or Enum.KeyCode.F3

    CURRENT_VERSION = GuiConfig.Version
    LoadConfigFromFile()

    local TabW = GuiConfig["Tab Width"]
    local Tabs = {}

    if UIRoot then
        local old = UIRoot:FindFirstChild("RCglob")
        if old then old:Destroy() end
        local oldToggle = UIRoot:FindFirstChild("ToggleUIButton")
        if oldToggle then oldToggle:Destroy() end
    end

    local RCglob = New("ScreenGui", {
        Name = "RCglob", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, UIRoot)

    -- Ukuran layar GUI yang sebenarnya (ikut berubah saat Roblox di-scale / di-minimize)
    local function ScreenSize()
        local sz = RCglob.AbsoluteSize
        if sz.X > 0 and sz.Y > 0 then return sz end
        return workspace.CurrentCamera.ViewportSize
    end

    local viewport = ScreenSize()
    local winW = math.min(680, viewport.X - 20)
    local winH = math.min(420, viewport.Y - 20)
    local MIN_W, MIN_H = math.min(520, winW), math.min(320, winH)

    -- Posisi & ukuran terakhir diingat (juga tersimpan di config)
    local startW, startH = winW, winH
    local startX = math.floor((viewport.X - winW) / 2)
    local startY = math.floor((viewport.Y - winH) / 2)
    local savedRect = ConfigData.WindowRect
    if type(savedRect) == "table" and tonumber(savedRect.w) and tonumber(savedRect.h)
        and tonumber(savedRect.x) and tonumber(savedRect.y) then
        startW = math.clamp(savedRect.w, MIN_W, math.max(MIN_W, viewport.X - 10))
        startH = math.clamp(savedRect.h, MIN_H, math.max(MIN_H, viewport.Y - 10))
        startX = math.clamp(savedRect.x, 0, math.max(0, viewport.X - startW))
        startY = math.clamp(savedRect.y, 0, math.max(0, viewport.Y - startH))
    end

    local Main = New("Frame", {
        Name = "Main", BackgroundColor3 = T.BG, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, startX, 0, startY),
        Size = UDim2.new(0, startW, 0, startH),
    }, RCglob)
    Corner(Main, 20)

    local GoldTweens = {}

    -- Popup / dropdown state
    local ClosePopup = nil

    -- ========================================================
    -- Animasi buka/tutup (ringan) + LOCK anti-spam
    --   * Saat animasi BUKA berjalan  -> tutup diabaikan sampai selesai
    --   * Saat animasi TUTUP berjalan -> buka diabaikan sampai selesai
    -- Konten di-fade lalu dilepas dari layar, yang bergerak hanya
    -- kotak kosong yang menyusut / membesar dari tombol bulat.
    -- ========================================================
    local ToggleBtn = nil
    local animating = false   -- true selama animasi buka / tutup masih jalan
    local Content = nil       -- dibuat setelah semua elemen dasar jadi
    local Overlay = nil       -- penutup fade

    local LastPos, LastSize = Main.Position, Main.Size
    local activeTween = nil
    local DesiredW, DesiredH = startW, startH -- ukuran pilihan user, dipakai lagi saat layar membesar

    -- Simpan posisi & ukuran HANYA kalau window terbuka penuh dan tidak sedang animasi
    local function CaptureRect(force)
        if not force and (animating or not Main.Visible) then return end
        local sz = Main.Size
        if sz.X.Offset < MIN_W or sz.Y.Offset < MIN_H then return end

        LastPos, LastSize = Main.Position, Main.Size
        DesiredW, DesiredH = sz.X.Offset, sz.Y.Offset
        ConfigData.WindowRect = {
            x = LastPos.X.Offset, y = LastPos.Y.Offset,
            w = LastSize.X.Offset, h = LastSize.Y.Offset,
        }
        SaveConfig()
    end

    -- Titik asal koordinat Main (dihitung dari Main sendiri saat terlihat) supaya
    -- target animasi tepat di tombol walau ada GUI inset / nested ScreenGui.
    local MainOrigin = RCglob.AbsolutePosition

    local function UpdateOrigin()
        MainOrigin = Main.AbsolutePosition - Vector2.new(Main.Position.X.Offset, Main.Position.Y.Offset)
    end

    local function ButtonRect()
        if ToggleBtn and ToggleBtn.Parent then
            local p, sz = ToggleBtn.AbsolutePosition - MainOrigin, ToggleBtn.AbsoluteSize
            return UDim2.new(0, p.X, 0, p.Y), UDim2.new(0, sz.X, 0, sz.Y)
        end
        local cx = LastPos.X.Offset + LastSize.X.Offset / 2
        local cy = LastPos.Y.Offset + LastSize.Y.Offset / 2
        return UDim2.new(0, cx - 21, 0, cy - 21), UDim2.new(0, 42, 0, 42)
    end

    local function CloseModals()
        for _, n in ipairs({ "CloseDialog", "ResetDialog", "GuideDialog", "ShareDialog" }) do
            local o = Main:FindFirstChild(n)
            if o then o:Destroy() end
        end
    end

    -- Jalankan tween Main; onDone dipanggil SEKALI saat selesai (ada fallback timeout
    -- supaya lock `animating` tidak pernah nyangkut)
    local function PlayMain(info, goal, onDone)
        if activeTween then pcall(function() activeTween:Cancel() end) end

        local tw = TweenService:Create(Main, info, goal)
        activeTween = tw
        local done = false

        local function Finish()
            if done then return end
            done = true
            if activeTween == tw then activeTween = nil end
            onDone()
        end

        tw.Completed:Connect(function(state)
            if state == Enum.PlaybackState.Completed then Finish() end
        end)
        task.delay(info.Time + 0.3, Finish)
        tw:Play()
    end

    local function HideWindow()
        if animating or not Main.Visible or not Content or not Overlay then return end
        animating = true
        if ClosePopup then ClosePopup() end
        CloseModals()

        CaptureRect(true)
        UpdateOrigin()
        local pos, size = ButtonRect()

        -- 1) fade konten (cepat)
        Overlay.BackgroundTransparency = 1
        Overlay.Visible = true
        Tween(Overlay, { BackgroundTransparency = 0 }, 0.12)

        task.delay(0.13, function()
            -- 2) lepas konten supaya animasi tidak berat, lalu sedot ke tombol
            Content.Parent = nil
            Overlay.Visible = false

            PlayMain(TweenInfo.new(0.42, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
                Position = pos, Size = size,
            }, function()
                Main.Visible = false
                Main.Position = LastPos
                Main.Size = LastSize
                animating = false -- baru boleh dibuka lagi
            end)
        end)
    end

    local function ShowWindow()
        if animating or Main.Visible or not Content or not Overlay then return end
        animating = true

        local pos, size = ButtonRect()
        Content.Parent = nil
        Overlay.Visible = false
        Main.Position = pos
        Main.Size = size
        Main.Visible = true

        PlayMain(TweenInfo.new(0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
            Position = LastPos, Size = LastSize,
        }, function()
            Main.Position = LastPos
            Main.Size = LastSize

            -- 3) pasang konten kembali di balik penutup, lalu fade in
            Overlay.BackgroundTransparency = 0
            Overlay.Visible = true
            Content.Parent = Main
            Tween(Overlay, { BackgroundTransparency = 1 }, 0.2)

            task.delay(0.22, function()
                Overlay.Visible = false
                animating = false -- baru boleh ditutup lagi
            end)
        end)
    end

    local function ToggleWindow()
        if animating then return end
        if Main.Visible then HideWindow() else ShowWindow() end
    end

    -- ===== Ikuti perubahan ukuran layar (Roblox di-scale / di-minimize di PC) =====
    -- Window dan tombol bulat dipindah secara PROPORSIONAL ke layar baru, lalu dijaga tetap di dalam layar.
    local prevScreen = viewport
    local fitQueued = false

    local function FitToScreen()
        local scr = ScreenSize()
        -- layar 0 / terlalu kecil (mis. Roblox di-minimize): abaikan supaya posisi tidak rusak
        if scr.X < 200 or scr.Y < 150 then return end
        if math.abs(scr.X - prevScreen.X) < 1 and math.abs(scr.Y - prevScreen.Y) < 1 then return end

        if ClosePopup then ClosePopup() end

        MIN_W = math.min(520, scr.X - 20)
        MIN_H = math.min(320, scr.Y - 20)

        local function Refit(pos, size)
            local w = math.clamp(DesiredW, MIN_W, math.max(MIN_W, scr.X - 10))
            local h = math.clamp(DesiredH, MIN_H, math.max(MIN_H, scr.Y - 10))
            -- titik tengah dipertahankan secara proporsional
            local cx = (pos.X.Offset + size.X.Offset / 2) / prevScreen.X * scr.X
            local cy = (pos.Y.Offset + size.Y.Offset / 2) / prevScreen.Y * scr.Y
            local x = math.clamp(cx - w / 2, 0, math.max(0, scr.X - w))
            local y = math.clamp(cy - h / 2, 0, math.max(0, scr.Y - h))
            return UDim2.new(0, math.floor(x), 0, math.floor(y)), UDim2.new(0, math.floor(w), 0, math.floor(h))
        end

        -- window (saat tersembunyi, ukuran tersimpan di LastPos/LastSize)
        local srcPos, srcSize = LastPos, LastSize
        if Main.Visible then srcPos, srcSize = Main.Position, Main.Size end
        LastPos, LastSize = Refit(srcPos, srcSize)
        Main.Position, Main.Size = LastPos, LastSize

        -- tombol bulat buka/tutup
        if ToggleBtn and ToggleBtn.Parent then
            local bw, bh = ToggleBtn.AbsoluteSize.X, ToggleBtn.AbsoluteSize.Y
            local p = ToggleBtn.Position
            local cx = (p.X.Offset + bw / 2) / prevScreen.X * scr.X
            local cy = (p.Y.Offset + bh / 2) / prevScreen.Y * scr.Y
            ToggleBtn.Position = UDim2.new(
                0, math.floor(math.clamp(cx - bw / 2, 0, math.max(0, scr.X - bw))),
                0, math.floor(math.clamp(cy - bh / 2, 0, math.max(0, scr.Y - bh)))
            )
        end

        prevScreen = scr
    end

    -- tunggu animasi buka/tutup selesai dulu, lalu sesuaikan (debounce saat layar ditarik-tarik)
    local function QueueFit()
        if fitQueued then return end
        fitQueued = true
        task.spawn(function()
            task.wait(0.05)
            local tries = 0
            while animating and tries < 40 do
                task.wait(0.1)
                tries = tries + 1
            end
            fitQueued = false
            FitToScreen()
        end)
    end

    RCglob:GetPropertyChangedSignal("AbsoluteSize"):Connect(QueueFit)

