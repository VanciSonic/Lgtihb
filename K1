    KZN_SearchNormalize = function(value)
        local text = tostring(value or ""):lower()
        text = text:gsub("%s+", " ")
        text = text:gsub("^%s+", "")
        text = text:gsub("%s+$", "")
        return text
    end

    KZN_SearchRegister = function(title, tabName, sectionName, frame, focusCallback)
        title = tostring(title or "")
        if title == "" or not frame then
            return
        end

        table.insert(SearchItems, {
            Title = title,
            SearchTitle = KZN_SearchNormalize(title),
            TabName = tostring(tabName or ""),
            SearchTab = KZN_SearchNormalize(tabName),
            SectionName = tostring(sectionName or ""),
            SearchSection = KZN_SearchNormalize(sectionName),
            Frame = frame,
            Focus = focusCallback
        })
    end

