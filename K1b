                    Size = UDim2.new(0, 40, 0, 20),
                }, row)
                Corner(ValueLabel, 6)
                Pad(ValueLabel, 4, 0, 6, 0)

                local Track = New("Frame", {
                    BackgroundColor3 = T.Track, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0),
                    Size = UDim2.new(0.42, 0, 0, 6),
                }, row)
                Corner(Track, 3)

                local Fill = New("Frame", {
                    BackgroundColor3 = GuiConfig.Color, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0),
                }, Track)
                Corner(Fill, 3)

                local Thumb = New("Frame", {
                    BackgroundColor3 = T.Text, BorderSizePixel = 0, ZIndex = 2,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12),
                }, Track)
                Corner(Thumb, 6)

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = UDim2.new(1, 12, 0, 24),
                }, Track)

                local F = { Value = cfg.Default }

                local function Visual()
                    local alpha = (F.Value - cfg.Min) / math.max(cfg.Max - cfg.Min, 1e-9)
                    alpha = math.clamp(alpha, 0, 1)
                    Fill.Size = UDim2.new(alpha, 0, 1, 0)
                    Thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
                    ValueLabel.Text = tostring(F.Value)
                end

                function F:Set(Value, silent)
                    Value = tonumber(Value) or cfg.Min
                    Value = math.clamp(RoundTo(Value - cfg.Min, cfg.Increment) + cfg.Min, cfg.Min, cfg.Max)
                    Value = math.floor(Value * 1000 + 0.5) / 1000
                    F.Value = Value
                    ConfigData[key] = Value
                    Visual()
                    if not silent then
                        SafeCall(cfg.Callback, Value)
                        SaveConfig()
                    end
                end

                -- input angka manual
                local typing = false
                ValueLabel.MouseEnter:Connect(function()
                    if not typing then Tween(ValueLabel, { BackgroundTransparency = 0.6 }) end
                end)
                ValueLabel.MouseLeave:Connect(function()
                    if not typing then Tween(ValueLabel, { BackgroundTransparency = 1 }) end
                end)
                ValueLabel.Focused:Connect(function()
                    typing = true
                    Tween(ValueLabel, { BackgroundTransparency = 0, TextColor3 = T.Text })
                end)
                ValueLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if not typing then return end
                    local cleaned = ValueLabel.Text:gsub("[^%d%.%-]", "")
                    if cleaned ~= ValueLabel.Text then
                        ValueLabel.Text = cleaned
                    end
                end)
                ValueLabel.FocusLost:Connect(function()
                    typing = false
                    Tween(ValueLabel, { BackgroundTransparency = 1, TextColor3 = T.Sub })
                    local num = tonumber(ValueLabel.Text)
                    if num then
                        F:Set(num)
                    else
                        Visual()
                    end
                end)

                local dragging = false
                local function UpdateFromInput(input)
                    local rel = (input.Position.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1)
                    rel = math.clamp(rel, 0, 1)
                    local v = cfg.Min + (cfg.Max - cfg.Min) * rel
                    if RoundTo(v - cfg.Min, cfg.Increment) + cfg.Min ~= F.Value then
                        F:Set(v)
                    end
                end

                Hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        SaveConfig()
                    end
                end)

                F:Set(F.Value, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

