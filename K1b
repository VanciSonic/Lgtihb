local RcHub = {}
local NotifyGui, NotifyHolder

function RcHub:MakeNotify(NotifyConfig)
    KZN_AssertThreadIdentity()
    NotifyConfig = NotifyConfig or {}
    NotifyConfig.Title       = NotifyConfig.Title or "GantenHub"
    NotifyConfig.Description = NotifyConfig.Description or "Notification"
    NotifyConfig.Content     = NotifyConfig.Content or ""
    NotifyConfig.Color       = NotifyConfig.Color or T.Text
    NotifyConfig.Delay       = NotifyConfig.Delay or 5

    if not NotifyGui or not NotifyGui.Parent then
        NotifyGui = New("ScreenGui", {
            Name = "RCnotify", ResetOnSpawn = false, IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, UIRoot)
        NotifyHolder = New("Frame", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -16, 1, -16),
            Size = UDim2.new(0, 270, 1, -32),
        }, NotifyGui)
        New("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }, NotifyHolder)
    end

    local Card = New("CanvasGroup", {
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        GroupTransparency = 1,
    }, NotifyHolder)
    Corner(Card, 14)
    Pad(Card, 14, 12, 14, 12)
    New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, Card)

    local Head = New("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1,
    }, Card)
    local Dot = New("Frame", {
        BackgroundColor3 = NotifyConfig.Color, Size = UDim2.new(0, 8, 0, 8),
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BorderSizePixel = 0,
    }, Head)
    Corner(Dot, 4)
    Label(Head, {
        Text = NotifyConfig.Title, Font = FONT_BOLD, TextSize = 13,
        Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -16, 1, 0),
    })

    Label(Card, {
        Text = NotifyConfig.Description, TextColor3 = T.Sub, TextSize = 12,
        Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2,
    })

    if NotifyConfig.Content ~= "" then
        Label(Card, {
            Text = NotifyConfig.Content, TextColor3 = T.Sub, TextSize = 11, TextWrapped = true,
            TextTruncate = Enum.TextTruncate.None, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3,
        })
    end

    Tween(Card, { GroupTransparency = 0 }, 0.25)

    local closed = false
    local function Close()
        if closed then return end
        closed = true
        local tw = Tween(Card, { GroupTransparency = 1 }, 0.25)
        tw.Completed:Connect(function()
            Card:Destroy()
        end)
    end

    task.delay(NotifyConfig.Delay, Close)
    return { Close = Close }
end

function rcchub(msg, delay, color, title, desc)
    return RcHub:MakeNotify({
        Title = title or "GantenHub",
        Description = desc or "Notification",
        Content = msg or "",
        Color = color,
        Delay = delay or 5,
    })
end

