                })
                local Content = Label(row, {
                    Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11, TextWrapped = true,
                    TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
                })

                local F = {}
                function F:SetContent(text)
                    Content.Text = tostring(text or "")
                end

                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Button
            -- ------------------------------------------------
            function Items:AddButton(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Confirm"
                cfg.Callback = cfg.Callback or function() end
                cfg.SubCallback = cfg.SubCallback or function() end

                local row = NewRow(34, cfg, true)

                local function Make(text, pos, size, cb)
                    local b = New("TextButton", {
                        Text = text, Font = FONT, TextSize = 12, TextColor3 = T.Text,
                        BackgroundColor3 = T.Control, BorderSizePixel = 0, AutoButtonColor = false,
                        Position = pos, Size = size,
                    }, row)
                    Corner(b, 10)
                    Hover(b, T.Control, T.Track)
                    b.Activated:Connect(function()
                        KZN_AssertThreadIdentity()
                        b.BackgroundColor3 = T.Text
                        b.TextColor3 = T.Dark
                        Tween(b, { BackgroundColor3 = T.Control, TextColor3 = T.Text }, 0.25)
                        SafeCall(cb)
                    end)
                    return b
                end

                local F = {}
                if cfg.SubTitle then
                    F.Button = Make(cfg.Title, UDim2.new(0, 0, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.Callback)
                    F.SubButton = Make(cfg.SubTitle, UDim2.new(0.5, 3, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.SubCallback)
                else
                    F.Button = Make(cfg.Title, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), cfg.Callback)
                end

                function F:Fire() SafeCall(cfg.Callback) end

                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Toggle
            -- ------------------------------------------------
            function Items:AddToggle(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Default = cfg.Default or false
                cfg.Callback = cfg.Callback or function() end

                local key = "Toggle_" .. cfg.Title
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                local Title = Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(1, -70, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(1, -70, 0, 16),
                    })
                end

                local Switch = New("Frame", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 34, 0, 18),
                }, row)
                Corner(Switch, 9)
                local Knob = New("Frame", {
                    BackgroundColor3 = Color3.fromRGB(190, 190, 190), BorderSizePixel = 0,
                    Position = UDim2.new(0, 3, 0, 3), Size = UDim2.new(0, 12, 0, 12),
                }, Switch)
                Corner(Knob, 6)

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                }, row)

                local F = { Value = cfg.Default }

                local function Visual()
                    if F.Value then
                        Tween(Switch, { BackgroundColor3 = GuiConfig.Color }, 0.2)
                        Tween(Knob, { Position = UDim2.new(0, 19, 0, 3), BackgroundColor3 = T.Dark }, 0.2)
                        Tween(Title, { TextColor3 = T.Text }, 0.2)
                    else
                        Tween(Switch, { BackgroundColor3 = T.Control }, 0.2)
                        Tween(Knob, { Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(190, 190, 190) }, 0.2)
                        Tween(Title, { TextColor3 = Color3.fromRGB(205, 205, 205) }, 0.2)
                    end
                end

                function F:Set(Value, silent)
                    F.Value = (Value == true)
                    ConfigData[key] = F.Value
                    Visual()
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                Hit.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    F:Set(not F.Value)
                end)

                F:Set(F.Value, true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Slider
            -- ------------------------------------------------
            function Items:AddSlider(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Slider"
                cfg.Content = cfg.Content or ""
                cfg.Increment = cfg.Increment or 1
                cfg.Min = cfg.Min or 0
                cfg.Max = cfg.Max or 100
                cfg.Default = cfg.Default or 50
                cfg.Callback = cfg.Callback or function() end

                local key = "Slider_" .. cfg.Title
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local ValueLabel = Label(row, {
                    Text = "", TextColor3 = T.Sub, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 34, 0, 16),
                })

                local Track = New("Frame", {
                    BackgroundColor3 = T.Track, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0),
                    Size = UDim2.new(0.42, 0, 0, 6),
                }, row)
                Corner(Track, 3)

                local Fill = New("Frame", {
                    BackgroundColor3 = GuiConfig.Color, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0),
                }, Track)
                Corner(Fill, 3)

                local Thumb = New("Frame", {
                    BackgroundColor3 = T.Text, BorderSizePixel = 0, ZIndex = 2,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12),
                }, Track)
                Corner(Thumb, 6)

                local Hit = New("TextButton", {
                    Text = "", BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = UDim2.new(1, 12, 0, 24),
                }, Track)

                local F = { Value = cfg.Default }

                local function Visual()
                    local alpha = (F.Value - cfg.Min) / math.max(cfg.Max - cfg.Min, 1e-9)
                    alpha = math.clamp(alpha, 0, 1)
                    Fill.Size = UDim2.new(alpha, 0, 1, 0)
                    Thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
                    ValueLabel.Text = tostring(F.Value)
                end

                function F:Set(Value, silent)
                    Value = tonumber(Value) or cfg.Min
                    Value = math.clamp(RoundTo(Value - cfg.Min, cfg.Increment) + cfg.Min, cfg.Min, cfg.Max)
                    Value = math.floor(Value * 1000 + 0.5) / 1000
                    F.Value = Value
                    ConfigData[key] = Value
                    Visual()
                    if not silent then
                        SafeCall(cfg.Callback, Value)
                        SaveConfig()
                    end
                end

                local dragging = false
                local function UpdateFromInput(input)
                    local rel = (input.Position.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1)
                    rel = math.clamp(rel, 0, 1)
                    local v = cfg.Min + (cfg.Max - cfg.Min) * rel
                    if RoundTo(v - cfg.Min, cfg.Increment) + cfg.Min ~= F.Value then
                        F:Set(v)
                    end
                end

                Hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateFromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        SaveConfig()
                    end
                end)

                F:Set(F.Value, true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Input
            -- ------------------------------------------------
            function Items:AddInput(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Callback = cfg.Callback or function() end
                cfg.Default = cfg.Default or ""

                local key = "Input_" .. cfg.Title
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local Box = New("TextBox", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ClearTextOnFocus = false,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = "",
                    PlaceholderText = cfg.Placeholder or "Ketik di sini", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0.52, -10, 0, 24),
                }, row)
                Corner(Box, 8)
                Pad(Box, 10, 0, 10, 0)

                local F = { Value = cfg.Default }

                function F:Set(Value, silent)
                    F.Value = tostring(Value or "")
                    Box.Text = F.Value
                    ConfigData[key] = F.Value
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                Box.FocusLost:Connect(function()
                    if Box.Text ~= F.Value then
                        F:Set(Box.Text)
                    end
                end)

                F:Set(F.Value, true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Panel (input + tombol)
            -- ------------------------------------------------
            function Items:AddPanel(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Default = cfg.Default or ""
                cfg.ButtonText = cfg.Button or cfg.ButtonText or "Confirm"
                cfg.ButtonCallback = cfg.Callback or cfg.ButtonCallback or function() end
                cfg.SubButtonText = cfg.SubButton or cfg.SubButtonText or nil
                cfg.SubButtonCallback = cfg.SubCallback or cfg.SubButtonCallback or function() end

                local key = "Panel_" .. cfg.Title
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local row = NewRow(110, cfg)
                row.AutomaticSize = Enum.AutomaticSize.Y
                row.Size = UDim2.new(1, 0, 0, 0)
                Pad(row, 10, 10, 10, 10)
                New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, row)

                Label(row, {
                    Text = cfg.Title, Font = FONT_BOLD, TextSize = 12, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1,
                })
                if cfg.Content ~= "" then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11, TextWrapped = true,
                        TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
                        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
                    })
                end

                local Box = New("TextBox", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ClearTextOnFocus = false,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = cfg.Default,
                    PlaceholderText = cfg.Placeholder or "Ketik di sini", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 3,
                }, row)
                Corner(Box, 8)
                Pad(Box, 10, 0, 10, 0)

                Box.FocusLost:Connect(function()
                    ConfigData[key] = Box.Text
                    SaveConfig()
                end)

                local Buttons = New("Frame", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 4,
                }, row)

                local function Make(text, pos, size, cb)
                    local b = New("TextButton", {
                        Text = text, Font = FONT, TextSize = 12, TextColor3 = T.Text,
                        BackgroundColor3 = T.Control, BorderSizePixel = 0, AutoButtonColor = false,
                        Position = pos, Size = size,
                    }, Buttons)
                    Corner(b, 8)
                    Hover(b, T.Control, T.Track)
                    b.Activated:Connect(function()
                        KZN_AssertThreadIdentity()
                        SafeCall(cb, Box.Text)
                    end)
                    return b
                end

                if cfg.SubButtonText then
                    Make(cfg.ButtonText, UDim2.new(0, 0, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.ButtonCallback)
                    Make(cfg.SubButtonText, UDim2.new(0.5, 3, 0, 0), UDim2.new(0.5, -3, 1, 0), cfg.SubButtonCallback)
                else
                    Make(cfg.ButtonText, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), cfg.ButtonCallback)
                end

                local F = {}
                function F:GetInput() return Box.Text end
                function F:Set(Value, silent)
                    Box.Text = tostring(Value or "")
                    ConfigData[key] = Box.Text
                    if not silent then SaveConfig() end
                end

                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            -- ------------------------------------------------
            -- Dropdown
            -- ------------------------------------------------
            function Items:AddDropdown(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or ""
                cfg.Multi = cfg.Multi or false
                cfg.Options = cfg.Options or {}
                cfg.Default = cfg.Default or (cfg.Multi and {} or nil)
                cfg.Callback = cfg.Callback or function() end

                local key = "Dropdown_" .. cfg.Title
                if ConfigData[key] ~= nil then cfg.Default = ConfigData[key] end

                local hasContent = cfg.Content ~= ""
                local row = NewRow(hasContent and 48 or 36, cfg)

                Label(row, {
                    Text = cfg.Title, TextSize = 12,
                    Position = UDim2.new(0, 12, 0, hasContent and 7 or 0),
                    Size = UDim2.new(0.42, -12, 0, hasContent and 16 or 36),
                })
                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local Pill = New("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0.52, -10, 0, 24),
                }, row)
                Corner(Pill, 8)
                Hover(Pill, T.Control, T.Track)

                local PillText = Label(Pill, {
                    Text = "", TextColor3 = Color3.fromRGB(205, 205, 205), TextSize = 11,
                    Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -28, 1, 0),
                })
                Label(Pill, {
                    Text = "▾", Font = FONT_BOLD, TextSize = 12, TextColor3 = T.Sub,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.new(0, 14, 1, 0),
                })

                local Popup = New("Frame", {
                    Name = "DropdownPopup", BackgroundColor3 = T.Popup, BorderSizePixel = 0,
                    Visible = false, ZIndex = 60, Size = UDim2.new(0, 150, 0, 100),
                }, Main)
                Corner(Popup, 12)

                local List = New("ScrollingFrame", {
                    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 61,
                    Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(1, -8, 1, -8),
                    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(120, 120, 120), Active = true,
                }, Popup)
                New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, List)

                local F = { Value = cfg.Multi and {} or nil, Options = cfg.Options, Opened = false }
                local OptionButtons = {}

                local function IsSelected(opt)
                    if cfg.Multi then
                        return type(F.Value) == "table" and IndexOf(F.Value, opt) ~= nil
                    end
                    return F.Value == opt
                end

                local function Display()
                    if cfg.Multi then
                        local t = (type(F.Value) == "table") and F.Value or {}
                        PillText.Text = (#t > 0) and table.concat(t, ", ") or "Pilih"
                    else
                        PillText.Text = (F.Value ~= nil) and tostring(F.Value) or "Pilih"
                    end
                end

                local function Styles()
                    for opt, b in pairs(OptionButtons) do
                        local on = IsSelected(opt)
                        b.BackgroundColor3 = on and Color3.fromRGB(230, 230, 230) or T.Popup
                        b.TextColor3 = on and T.Dark or Color3.fromRGB(205, 205, 205)
                    end
                end

                local function Close()
                    F.Opened = false
                    Popup.Visible = false
                    if ClosePopup == F.CloseFn then ClosePopup = nil end
                end

                F.CloseFn = function(pos)
                    if pos then
                        local function inside(gui)
                            local p, s = gui.AbsolutePosition, gui.AbsoluteSize
                            return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
                        end
                        if inside(Popup) or inside(Pill) then return end
                    end
                    Close()
                end

                function F:Set(Value, silent)
                    if cfg.Multi then
                        local copy = {}
                        if type(Value) == "table" then
                            for _, v in ipairs(Value) do table.insert(copy, v) end
                        end
                        Value = copy
                    end
                    F.Value = Value
                    ConfigData[key] = Value
                    Styles()
                    Display()
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                local function Rebuild()
                    for _, c in ipairs(List:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    OptionButtons = {}

                    for i, opt in ipairs(F.Options) do
                        local b = New("TextButton", {
                            Text = tostring(opt), Font = FONT, TextSize = 11, TextColor3 = T.Text,
                            BackgroundColor3 = T.Popup, BorderSizePixel = 0, AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 62,
                            Size = UDim2.new(1, -6, 0, 26), LayoutOrder = i,
                        }, List)
                        Corner(b, 8)
                        Pad(b, 10, 0, 6, 0)
                        OptionButtons[opt] = b

                        b.Activated:Connect(function()
                            KZN_AssertThreadIdentity()
                            if cfg.Multi then
                                local cur = {}
                                for _, v in ipairs(type(F.Value) == "table" and F.Value or {}) do
                                    table.insert(cur, v)
                                end
                                local idx = IndexOf(cur, opt)
                                if idx then table.remove(cur, idx) else table.insert(cur, opt) end
                                F:Set(cur)
                            else
                                F:Set(opt)
                                Close()
                            end
                        end)
                    end

                    Styles()
                end

                local function Open()
                    if ClosePopup then ClosePopup() end

                    local width = math.max(Pill.AbsoluteSize.X, 150)
                    local height = math.min(#F.Options * 28 + 8, 172)
                    local p = Pill.AbsolutePosition - Main.AbsolutePosition
                    local x = p.X + Pill.AbsoluteSize.X - width
                    local y = p.Y + Pill.AbsoluteSize.Y + 4
                    if y + height > Main.AbsoluteSize.Y - 8 then
                        y = p.Y - height - 4
                    end

                    Popup.Size = UDim2.new(0, width, 0, height)
                    Popup.Position = UDim2.new(0, math.clamp(x, 8, Main.AbsoluteSize.X - width - 8), 0, math.max(y, 8))
                    Popup.Visible = true
                    F.Opened = true
                    ClosePopup = F.CloseFn
                end

                Pill.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    if F.Opened then Close() else Open() end
                end)

                function F:Clear()
                    F.Options = {}
                    F.Value = cfg.Multi and {} or nil
                    ConfigData[key] = F.Value
                    Rebuild()
                    Display()
                end

                function F:AddOption(option)
                    table.insert(F.Options, option)
                    Rebuild()
                end

                function F:SetValues(newList, selecting, silent)
                    F.Options = newList or {}
                    Rebuild()
                    F:Set(selecting, silent)
                end

                function F:SetValue(val) F:Set(val) end
                function F:GetValue() return F.Value end

                F:SetValues(F.Options, cfg.Default, true)
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            return Items
        end

        local safeName = TabConfig.Name:gsub("%s+", "_")
        _G[safeName] = Sections
        return Sections
    end

    return Tabs
end

return RcHub
