-- Baca masa aktif key dari getgenv().ExpiresAt (nil = permanent)
-- Boleh berupa unix time (detik / milidetik) atau teks "YYYY-MM-DD" / "YYYY-MM-DD HH:MM:SS"
local function GetExpiresAt()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local v = env and env.ExpiresAt
    if v == nil or v == false or v == 0 then return nil end

    if type(v) == "number" then
        if v > 1e12 then v = v / 1000 end
        return v
    end

    if type(v) == "string" then
        if string.lower(v) == "permanent" then return nil end
        local num = tonumber(v)
        if num then
            if num > 1e12 then num = num / 1000 end
            return num
        end

        -- contoh: "2026-11-11 06:37:44" (boleh ada teks lain di depan, mis. "Expires At 2026-...")
        local y, mo, d, h, mi, sec = v:match("(%d%d%d%d)%-(%d+)%-(%d+)[ T]+(%d+):(%d+):?(%d*)")
        if not y then
            y, mo, d = v:match("(%d%d%d%d)%-(%d+)%-(%d+)")
            h, mi, sec = 0, 0, 0
        end
        if y then
            local ok, t = pcall(os.time, {
                year = tonumber(y), month = tonumber(mo), day = tonumber(d),
                hour = tonumber(h) or 0, min = tonumber(mi) or 0, sec = tonumber(sec) or 0,
            })
            if ok and t then
                -- os.time(table) dibaca sebagai UTC. Kalau tanggalmu waktu WIB, set getgenv().ExpiresTZ = 7
                local tz = tonumber(env.ExpiresTZ) or 0
                return t - tz * 3600
            end
        end
    end
    return nil
end

-- Warna peringatan: <= 3 hari kuning, <= 1 hari orange, <= 10 jam merah, expired merah
local COLOR_YELLOW = Color3.fromRGB(255, 214, 80)
local COLOR_ORANGE = Color3.fromRGB(255, 150, 60)
local COLOR_RED    = Color3.fromRGB(255, 90, 90)

local function ExpiryColor(left)
    if left <= 10 * 3600 then return COLOR_RED end
    if left <= 86400 then return COLOR_ORANGE end
    if left <= 3 * 86400 then return COLOR_YELLOW end
    return nil
end

-- Header: "Exp : 4d 03h 12m"  -> text, warna (nil = default), expired?
local function FormatExpiryShort()
    local exp = GetExpiresAt()
    if not exp then
        return "Exp : Permanent", nil, false
    end

    local left = math.floor(exp - os.time())
    if left <= 0 then
        return "Exp : Expired", COLOR_RED, true
    end

    local days = math.floor(left / 86400)
    local hours = math.floor((left % 86400) / 3600)
    local mins = math.floor((left % 3600) / 60)
    return string.format("Exp : %dd %02dh %02dm", days, hours, mins), ExpiryColor(left), false
end

-- User card: hanya sisa hari -> text, warna (nil = default)
local function FormatKeyStatus()
    local exp = GetExpiresAt()
    if not exp then
        return "Permanent", nil
    end

    local left = math.floor(exp - os.time())
    if left <= 0 then
        return "Expired", COLOR_RED
    end

    local days = math.floor(left / 86400)
    if days >= 1 then
        return string.format("%d day", days), ExpiryColor(left)
    end
    return "<1 day", ExpiryColor(left)
end

local function IndexOf(tbl, value)
    for i, v in ipairs(tbl) do
        if v == value then return i end
    end
    return nil
end

local function RoundTo(value, step)
    step = (step and step > 0) and step or 1
    local r = math.floor(value / step + 0.5) * step
    return math.floor(r * 1000 + 0.5) / 1000
end

