    local function RefreshChips(tab)
        for _, s in ipairs(tab.SectionList) do
            local on = (tab.ActiveSection == s)
            Tween(s.Chip, {
                BackgroundColor3 = on and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(42, 42, 42),
            })
            Tween(s.ChipText, { TextColor3 = on and T.Dark or T.Sub })
            if s.CountLabel then
                Tween(s.CountLabel, { TextColor3 = on and T.Dark or T.Sub })
            end
        end
    end

    local function ShowSection(tab, sec)
        tab.ActiveSection = sec
        for _, s in ipairs(tab.SectionList) do
            s.Page.Visible = (tab == ActiveTab) and (s == sec)
        end
        RefreshChips(tab)
    end

    local function SelectTab(tab)
        if ClosePopup then ClosePopup() end
        ActiveTab = tab

        for _, t in ipairs(TabList) do
            local on = (t == tab)
            Tween(t.Button, { BackgroundTransparency = on and 0 or 1 })
            Tween(t.Label, { TextColor3 = on and T.Dark or T.Sub })
            if t.IconImage then
                Tween(t.IconImage, { ImageColor3 = on and T.Dark or T.Sub })
            end
            for _, s in ipairs(t.SectionList) do
                s.Chip.Visible = on
                if not on then s.Page.Visible = false end
            end
        end

        NameTab.Text = tab.Name
        SectionScroll.CanvasPosition = Vector2.new(0, 0)

        local sec = tab.ActiveSection or tab.SectionList[1]
        if sec then ShowSection(tab, sec) end
    end

    -- --------------------------------------------------------
    -- AddTab
    -- --------------------------------------------------------
    function Tabs:AddTab(TabConfig)
        TabConfig = TabConfig or {}
        TabConfig.Name = TabConfig.Name or "Tab"
        TabConfig.Icon = TabConfig.Icon or ""

        local Tab = { Name = TabConfig.Name, SectionList = {}, ActiveSection = nil }

        local Button = New("TextButton", {
            Name = "Tab_" .. TabConfig.Name, Text = "", AutoButtonColor = false,
            BackgroundColor3 = T.Text, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 34), LayoutOrder = CountTab,
        }, ScrollTab)
        Corner(Button, 10)

        local iconAsset = ResolveIcon(TabConfig.Icon)
        local textX = 12
        if iconAsset ~= "" then
            Tab.IconImage = New("ImageLabel", {
                BackgroundTransparency = 1, Image = iconAsset, ImageColor3 = T.Sub,
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.new(0, 16, 0, 16),
            }, Button)
            textX = 36
        end

        local TabLabel = Label(Button, {
            Text = TabConfig.Name, TextColor3 = T.Sub, TextSize = 12,
            Position = UDim2.new(0, textX, 0, 0), Size = UDim2.new(1, -(textX + 6), 1, 0),
        })

        Tab.Button = Button
        Tab.Label = TabLabel

        Button.MouseEnter:Connect(function()
            if ActiveTab ~= Tab then Tween(TabLabel, { TextColor3 = T.Text }) end
        end)
        Button.MouseLeave:Connect(function()
            if ActiveTab ~= Tab then Tween(TabLabel, { TextColor3 = T.Sub }) end
        end)
        Button.Activated:Connect(function()
            KZN_AssertThreadIdentity()
            SelectTab(Tab)
        end)

        table.insert(TabList, Tab)
        CountTab = CountTab + 1

        local Sections = {}
        local CountSection = 0

        -- ----------------------------------------------------
        -- AddSection (chip + halaman dua kolom)
        -- ----------------------------------------------------
        -- AddSection(Title, TwoColumn)
        --   TwoColumn = true  -> 2 kolom untuk element
        --   TwoColumn = false / nil (default) -> 1 kolom
        function Sections:AddSection(Title, TwoColumn)
            Title = Title or "Section"
            local twoCol = (TwoColumn == true)
            local Sec = {}

            local Chip = New("TextButton", {
                Name = "Chip_" .. Title, Text = "", AutoButtonColor = false,
                BackgroundColor3 = Color3.fromRGB(42, 42, 42), BorderSizePixel = 0,
                Size = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.X,
                LayoutOrder = CountSection, Visible = (ActiveTab == Tab),
            }, SectionScroll)
            Corner(Chip, 13)
            Pad(Chip, 14, 0, 14, 0)

            local Inner = New("Frame", {
                BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            }, Chip)
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7),
                VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
            }, Inner)

            local ChipText = Label(Inner, {
                Text = Title, TextColor3 = T.Sub, TextSize = 12, TextTruncate = Enum.TextTruncate.None,
                Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1,
            })

            -- Status jumlah toggle ON per section:  "11 ●"  (bulat hijau kalau ada yang ON)
            local Badge = New("Frame", {
                BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X,
                LayoutOrder = 2,
            }, Inner)
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
                VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
            }, Badge)
            local CountLabel = Label(Badge, {
                Text = "0", Font = FONT_BOLD, TextColor3 = T.Sub, TextSize = 11, TextTruncate = Enum.TextTruncate.None,
                Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1,
            })
            local StatusDot = New("Frame", {
                BackgroundColor3 = Color3.fromRGB(95, 95, 95), BorderSizePixel = 0,
                Size = UDim2.new(0, 8, 0, 8), LayoutOrder = 2,
            }, Badge)
            Corner(StatusDot, 4)

            Sec.Chip = Chip
            Sec.ChipText = ChipText
            Sec.CountLabel = CountLabel
            Sec.Toggles = {}

            function Sec.UpdateBadge()
                local n = 0
                for _, t in ipairs(Sec.Toggles) do
                    if t.Value == true then n = n + 1 end
                end
                CountLabel.Text = tostring(n)
                Tween(StatusDot, {
                    BackgroundColor3 = (n > 0) and Color3.fromRGB(70, 220, 120) or Color3.fromRGB(95, 95, 95),
                }, 0.2)
            end

            local Page = New("Frame", {
                Name = "Page_" .. Title, BackgroundTransparency = 1, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 1, 0), Visible = false,
            }, Layers)
            Sec.Page = Page

            local cols = {}
            for i = 1, (twoCol and 2 or 1) do
                local sf = New("ScrollingFrame", {
                    Name = "Column" .. i, BackgroundColor3 = T.Panel, BorderSizePixel = 0,
                    Position = twoCol and UDim2.new(i == 1 and 0 or 0.5, i == 1 and 0 or 5, 0, 0) or UDim2.new(0, 0, 0, 0),
                    Size = twoCol and UDim2.new(0.5, -5, 1, 0) or UDim2.new(1, 0, 1, 0),
                    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100),
                    ScrollingDirection = Enum.ScrollingDirection.Y, Active = true,
                }, Page)
                Corner(sf, 16)
                Pad(sf, 8, 8, 12, 8)
                New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
                cols[i] = { Frame = sf, n = 0, h = 0 }
            end

            table.insert(Tab.SectionList, Sec)
            CountSection = CountSection + 1

            Chip.Activated:Connect(function()
                if ClosePopup then ClosePopup() end
                ShowSection(Tab, Sec)
            end)

            if not Tab.ActiveSection then
                Tab.ActiveSection = Sec
            end
            if ActiveTab == nil then
                SelectTab(Tab)
            elseif ActiveTab == Tab then
                ShowSection(Tab, Tab.ActiveSection)
            end

            local Items = {}

            -- pilih kolom (otomatis ke kolom yang lebih pendek)
            local function NewRow(height, cfg, transparent)
                local idx = cfg and cfg.Column
                if not twoCol then
                    idx = 1
                elseif idx ~= 1 and idx ~= 2 then
                    idx = (cols[1].h <= cols[2].h) and 1 or 2
                end
                local col = cols[idx]
                col.h = col.h + height + 6
                col.n = col.n + 1

                local row = New("Frame", {
                    BackgroundColor3 = T.Row, BackgroundTransparency = transparent and 1 or 0,
                    BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), LayoutOrder = col.n,
                }, col.Frame)
                if not transparent then Corner(row, 10) end
                return row
            end

            local function ApplyLock(row, cfg)
                if not cfg.Locked then return end
                local Blocker = New("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = T.BG, BackgroundTransparency = 0.45,
                    BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = 10,
                }, row)
                Corner(Blocker, 10)

                local Tag = New("Frame", {
