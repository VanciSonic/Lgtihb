                if hasContent then
                    Label(row, {
                        Text = cfg.Content, TextColor3 = T.Sub, TextSize = 11,
                        Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(0.42, -12, 0, 16),
                    })
                end

                local Pill = New("TextButton", {
                    Text = "", AutoButtonColor = false, BackgroundColor3 = T.Control, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.new(0.52, -10, 0, 24),
                }, row)
                Corner(Pill, 8)
                Hover(Pill, T.Control, T.Track)

                local PillText = Label(Pill, {
                    Text = "", TextColor3 = Color3.fromRGB(205, 205, 205), TextSize = 11,
                    Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -30, 1, 0),
                })

                -- Panah chevron (digambar dari Frame): kanan = tertutup, bawah = terbuka
                local Chevron = New("Frame", {
                    BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.new(0, 10, 0, 10), Rotation = -90,
                }, Pill)
                for _, d in ipairs({ { 3.1, 45 }, { 6.9, -45 } }) do
                    local bar = New("Frame", {
                        BackgroundColor3 = T.Sub, BorderSizePixel = 0,
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, d[1], 0, 5),
                        Size = UDim2.new(0, 6, 0, 2), Rotation = d[2],
                    }, Chevron)
                    Corner(bar, 1)
                end

                local HEADER = 38

                local Popup = New("Frame", {
                    Name = "DropdownPopup", BackgroundColor3 = T.Popup, BorderSizePixel = 0,
                    Visible = false, ZIndex = 60, ClipsDescendants = true, Size = UDim2.new(0, 150, 0, 0),
                }, Main)
                Corner(Popup, 12)

                local SearchWrap = New("Frame", {
                    BackgroundColor3 = T.Control, BorderSizePixel = 0, ZIndex = 61,
                    Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 26),
                }, Popup)
                Corner(SearchWrap, 8)

                local SearchInput = New("TextBox", {
                    BackgroundTransparency = 1, ClearTextOnFocus = false, ZIndex = 62,
                    Font = FONT, TextSize = 11, TextColor3 = T.Text, Text = "",
                    PlaceholderText = "Cari...", PlaceholderColor3 = T.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0),
                }, SearchWrap)

                local List = New("ScrollingFrame", {
                    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 61,
                    Position = UDim2.new(0, 4, 0, HEADER), Size = UDim2.new(1, -8, 1, -(HEADER + 4)),
                    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(120, 120, 120), Active = true,
                }, Popup)
                New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, List)

                local EmptyLabel = Label(List, {
                    Text = "Tidak ditemukan", TextColor3 = T.Muted, TextSize = 11, ZIndex = 62,
                    TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -6, 0, 26),
                    LayoutOrder = 99999, Visible = false,
                })

                local F = { Value = cfg.Multi and {} or nil, Options = cfg.Options, Opened = false }
                local OptionButtons = {}
                local openUp = false
                local animToken = 0

                local function IsSelected(opt)
                    if cfg.Multi then
                        return type(F.Value) == "table" and IndexOf(F.Value, opt) ~= nil
                    end
                    return F.Value == opt
                end

                local function Display()
                    if cfg.Multi then
                        local t = (type(F.Value) == "table") and F.Value or {}
                        PillText.Text = (#t > 0) and table.concat(t, ", ") or "Pilih"
                    else
                        PillText.Text = (F.Value ~= nil) and tostring(F.Value) or "Pilih"
                    end
                end

                local function Styles()
                    for opt, b in pairs(OptionButtons) do
                        local on = IsSelected(opt)
                        b.BackgroundColor3 = on and Color3.fromRGB(230, 230, 230) or T.Popup
                        b.TextColor3 = on and T.Dark or Color3.fromRGB(205, 205, 205)
                    end
                end

                local function TargetRect()
                    local count = 0
                    for _, b in pairs(OptionButtons) do
                        if b.Visible then count = count + 1 end
                    end
                    if count == 0 then count = 1 end

                    local width = math.max(Pill.AbsoluteSize.X, 170)
                    local height = math.min(count * 28 + 8, 172) + HEADER
                    local p = Pill.AbsolutePosition - Main.AbsolutePosition
                    local x = p.X + Pill.AbsoluteSize.X - width
                    local below = p.Y + Pill.AbsoluteSize.Y + 4
                    local y = below

                    openUp = (below + height > Main.AbsoluteSize.Y - 8)
                    if openUp then y = p.Y - height - 4 end

                    x = math.clamp(x, 8, math.max(8, Main.AbsoluteSize.X - width - 8))
                    y = math.max(y, 8)
                    return x, y, width, height
                end

                local function ApplyFilter()
                    local q = Normalize(SearchInput.Text)
                    local shown = 0
                    for opt, b in pairs(OptionButtons) do
                        local ok = (q == "") or (string.find(string.lower(tostring(opt)), q, 1, true) ~= nil)
                        b.Visible = ok
                        if ok then shown = shown + 1 end
                    end
                    EmptyLabel.Visible = (shown == 0)
                    List.CanvasPosition = Vector2.new(0, 0)

                    if F.Opened then
                        local x, y, w, h = TargetRect()
                        Tween(Popup, { Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y) }, 0.12)
                    end
                end

                SearchInput:GetPropertyChangedSignal("Text"):Connect(ApplyFilter)

                local function Close()
                    if not F.Opened then return end
                    F.Opened = false
                    if ClosePopup == F.CloseFn then ClosePopup = nil end

                    animToken = animToken + 1
                    local token = animToken
                    SearchInput:ReleaseFocus()
                    Tween(Chevron, { Rotation = -90 }, 0.18)

                    -- menyusut / tersedot kembali ke tombol dropdown
                    local w, h = Popup.AbsoluteSize.X, Popup.AbsoluteSize.Y
                    local px, py = Popup.Position.X.Offset, Popup.Position.Y.Offset
                    local endY = openUp and (py + h) or py
                    local tw = Tween(Popup, { Size = UDim2.new(0, w, 0, 0), Position = UDim2.new(0, px, 0, endY) }, 0.16)
                    tw.Completed:Connect(function()
                        if animToken == token then Popup.Visible = false end
                    end)
                end

                F.CloseFn = function(pos)
                    if pos then
                        local function inside(gui)
                            local p, s = gui.AbsolutePosition, gui.AbsoluteSize
                            return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
                        end
                        if inside(Popup) or inside(Pill) then return end
                    end
                    Close()
                end

                function F:Set(Value, silent)
                    if cfg.Multi then
                        local copy = {}
                        if type(Value) == "table" then
                            for _, v in ipairs(Value) do table.insert(copy, v) end
                        end
                        Value = copy
                    end
                    F.Value = Value
                    ConfigData[key] = Value
                    Styles()
                    Display()
                    if not silent then
                        SafeCall(cfg.Callback, F.Value)
                        SaveConfig()
                    end
                end

                local function Rebuild()
                    for _, c in ipairs(List:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    OptionButtons = {}

                    for i, opt in ipairs(F.Options) do
                        local b = New("TextButton", {
                            Text = tostring(opt), Font = FONT, TextSize = 11, TextColor3 = T.Text,
                            BackgroundColor3 = T.Popup, BorderSizePixel = 0, AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 62,
                            Size = UDim2.new(1, -6, 0, 26), LayoutOrder = i,
                        }, List)
                        Corner(b, 8)
                        Pad(b, 10, 0, 6, 0)
                        OptionButtons[opt] = b

                        b.Activated:Connect(function()
                            KZN_AssertThreadIdentity()
                            if cfg.Multi then
                                local cur = {}
                                for _, v in ipairs(type(F.Value) == "table" and F.Value or {}) do
                                    table.insert(cur, v)
                                end
                                local idx = IndexOf(cur, opt)
                                if idx then table.remove(cur, idx) else table.insert(cur, opt) end
                                F:Set(cur)
                            else
                                F:Set(opt)
                                Close()
                            end
                        end)
                    end

                    Styles()
                    if Normalize(SearchInput.Text) ~= "" then ApplyFilter() else EmptyLabel.Visible = (#F.Options == 0) end
                end

                local function Open()
                    if ClosePopup then ClosePopup() end

                    SearchInput.Text = ""
                    ApplyFilter()

                    animToken = animToken + 1
                    local x, y, w, h = TargetRect()
                    local startY = openUp and (y + h) or y

                    Popup.Size = UDim2.new(0, w, 0, 0)
                    Popup.Position = UDim2.new(0, x, 0, startY)
                    Popup.Visible = true
                    Tween(Popup, { Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y) }, 0.2)
                    Tween(Chevron, { Rotation = 0 }, 0.2)

                    F.Opened = true
                    ClosePopup = F.CloseFn

                    if not UserInputService.TouchEnabled then
                        task.defer(function()
                            if F.Opened then SearchInput:CaptureFocus() end
                        end)
                    end
                end

                Pill.Activated:Connect(function()
                    KZN_AssertThreadIdentity()
                    if F.Opened then Close() else Open() end
                end)

                function F:Clear()
                    F.Options = {}
                    F.Value = cfg.Multi and {} or nil
                    ConfigData[key] = F.Value
                    Rebuild()
                    Display()
                end

                function F:AddOption(option)
                    table.insert(F.Options, option)
                    Rebuild()
                end

                function F:SetValues(newList, selecting, silent)
                    F.Options = newList or {}
                    Rebuild()
                    F:Set(selecting, silent)
                end

                function F:SetValue(val) F:Set(val) end
                function F:GetValue() return F.Value end

                F:SetValues(F.Options, cfg.Default, true)
                F.DefaultValue = DefaultValue
                F.Resettable = true
                Elements[key] = F
                ApplyLock(row, cfg)
                Register(cfg.Title, row)
                return F
            end

            return Items
        end

        local safeName = TabConfig.Name:gsub("%s+", "_")
        _G[safeName] = Sections
        return Sections
    end

    return Tabs
end

return RcHub
