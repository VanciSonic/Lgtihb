function RcHub:Window(GuiConfig)
    KZN_AssertThreadIdentity()
    GuiConfig              = GuiConfig or {}
    GuiConfig.Title        = BRAND_NAME
    GuiConfig.Footer       = BRAND_TAG
    GuiConfig.Color        = GuiConfig.Color or T.Text
    GuiConfig["Tab Width"] = math.max(GuiConfig["Tab Width"] or 150, 120)
    GuiConfig.Version      = GuiConfig.Version or 1
    GuiConfig.ToggleKey    = GuiConfig.ToggleKey or Enum.KeyCode.F3

    CURRENT_VERSION = GuiConfig.Version
    LoadConfigFromFile()

    local TabW = GuiConfig["Tab Width"]
    local Tabs = {}

    if UIRoot then
        local old = UIRoot:FindFirstChild("RCglob")
        if old then old:Destroy() end
        local oldToggle = UIRoot:FindFirstChild("ToggleUIButton")
        if oldToggle then oldToggle:Destroy() end
    end

    local viewport = workspace.CurrentCamera.ViewportSize
    local winW = math.min(680, viewport.X - 20)
    local winH = math.min(420, viewport.Y - 20)
    local MIN_W, MIN_H = math.min(520, winW), math.min(320, winH)

    local RCglob = New("ScreenGui", {
        Name = "RCglob", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, UIRoot)

    -- Posisi & ukuran terakhir diingat (juga tersimpan di config)
    local startW, startH = winW, winH
    local startX = math.floor((viewport.X - winW) / 2)
    local startY = math.floor((viewport.Y - winH) / 2)
    local savedRect = ConfigData.WindowRect
    if type(savedRect) == "table" and tonumber(savedRect.w) and tonumber(savedRect.h)
        and tonumber(savedRect.x) and tonumber(savedRect.y) then
        startW = math.clamp(savedRect.w, MIN_W, math.max(MIN_W, viewport.X - 10))
        startH = math.clamp(savedRect.h, MIN_H, math.max(MIN_H, viewport.Y - 10))
        startX = math.clamp(savedRect.x, 0, math.max(0, viewport.X - startW))
        startY = math.clamp(savedRect.y, 0, math.max(0, viewport.Y - startH))
    end

    local Main = New("Frame", {
        Name = "Main", BackgroundColor3 = T.BG, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, startX, 0, startY),
        Size = UDim2.new(0, startW, 0, startH),
    }, RCglob)
    Corner(Main, 20)

    local GoldTweens = {}

    -- Popup / dropdown state
    local ClosePopup = nil

    -- Animasi buka/tutup window (ringan): konten di-fade lalu dilepas dari layar,
    -- yang bergerak hanya kotak kosong yang menyusut / membesar dari tombol bulat.
    local ToggleBtn = nil
    local animating = false
    local Content = nil   -- dibuat setelah semua elemen dasar jadi
    local Overlay = nil   -- penutup fade

    local LastPos, LastSize = Main.Position, Main.Size

    local function CaptureRect()
        LastPos, LastSize = Main.Position, Main.Size
        ConfigData.WindowRect = {
            x = LastPos.X.Offset, y = LastPos.Y.Offset,
            w = LastSize.X.Offset, h = LastSize.Y.Offset,
        }
        SaveConfig()
    end

    -- Titik asal koordinat Main (dihitung dari Main sendiri saat terlihat) supaya
    -- target animasi tepat di tombol walau ada GUI inset / nested ScreenGui.
    local MainOrigin = RCglob.AbsolutePosition

    local function UpdateOrigin()
        MainOrigin = Main.AbsolutePosition - Vector2.new(Main.Position.X.Offset, Main.Position.Y.Offset)
    end

    local function ButtonRect()
        if ToggleBtn and ToggleBtn.Parent then
            local p, sz = ToggleBtn.AbsolutePosition - MainOrigin, ToggleBtn.AbsoluteSize
            return UDim2.new(0, p.X, 0, p.Y), UDim2.new(0, sz.X, 0, sz.Y)
        end
        local cx = LastPos.X.Offset + LastSize.X.Offset / 2
        local cy = LastPos.Y.Offset + LastSize.Y.Offset / 2
        return UDim2.new(0, cx - 21, 0, cy - 21), UDim2.new(0, 42, 0, 42)
    end

    local function CloseModals()
        for _, n in ipairs({ "CloseDialog", "ResetDialog", "GuideDialog" }) do
            local o = Main:FindFirstChild(n)
            if o then o:Destroy() end
        end
    end

    local function HideWindow()
        if animating or not Main.Visible or not Content or not Overlay then return end
        animating = true
        if ClosePopup then ClosePopup() end
        CloseModals()

        CaptureRect()
        UpdateOrigin()
        local pos, size = ButtonRect()

        -- 1) fade konten (cepat)
        Overlay.BackgroundTransparency = 1
        Overlay.Visible = true
        Tween(Overlay, { BackgroundTransparency = 0 }, 0.12)

        task.delay(0.13, function()
            -- 2) lepas konten supaya animasi tidak berat, lalu sedot ke tombol
            Content.Parent = nil
            Overlay.Visible = false
            TweenService:Create(Main, TweenInfo.new(0.42, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
                Position = pos, Size = size,
            }):Play()

            task.delay(0.44, function()
                Main.Visible = false
                Main.Position = LastPos
                Main.Size = LastSize
                animating = false
            end)
        end)
    end

    local function ShowWindow()
        if animating or Main.Visible or not Content or not Overlay then return end
        animating = true

        local pos, size = ButtonRect()
        Content.Parent = nil
        Overlay.Visible = false
        Main.Position = pos
        Main.Size = size
        Main.Visible = true

        TweenService:Create(Main, TweenInfo.new(0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
            Position = LastPos, Size = LastSize,
        }):Play()

        task.delay(0.47, function()
            Main.Position = LastPos
            Main.Size = LastSize

            -- 3) pasang konten kembali di balik penutup, lalu fade in
            Overlay.BackgroundTransparency = 0
            Overlay.Visible = true
            Content.Parent = Main
            Tween(Overlay, { BackgroundTransparency = 1 }, 0.2)

            task.delay(0.22, function()
                Overlay.Visible = false
                animating = false
            end)
        end)
    end

    local function ToggleWindow()
        if Main.Visible then HideWindow() else ShowWindow() end
    end

    -- ===== Modal / popup di dalam window =====
    local function OpenModal(name, maxW, maxH)
        local old = Main:FindFirstChild(name)
        if old then old:Destroy() end

        local Overlay = New("TextButton", {
            Name = name, Text = "", AutoButtonColor = false,
            BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0), ZIndex = 85,
        }, Main)
        Corner(Overlay, 20)

        local Card = New("Frame", {
            BackgroundColor3 = T.Panel, BorderSizePixel = 0, Active = true, ZIndex = 86,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0.9, 0, 0.9, 0),
        }, Overlay)
        Corner(Card, 18)
        New("UISizeConstraint", { MaxSize = Vector2.new(maxW, maxH) }, Card)
        local CardScale = New("UIScale", { Scale = 0.92 }, Card)

        local XBtn = New("TextButton", {
            Text = "×", Font = FONT_BOLD, TextSize = 16, TextColor3 = T.Sub, BackgroundColor3 = T.Control,
            BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 90,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, 26, 0, 26),
        }, Card)
        Corner(XBtn, 13)
        XBtn.MouseEnter:Connect(function() Tween(XBtn, { BackgroundColor3 = T.Track, TextColor3 = T.Text }) end)
        XBtn.MouseLeave:Connect(function() Tween(XBtn, { BackgroundColor3 = T.Control, TextColor3 = T.Sub }) end)

        local closed = false
        local function Close()
            if closed then return end
            closed = true
            Tween(Overlay, { BackgroundTransparency = 1 }, 0.15)
            Tween(CardScale, { Scale = 0.92 }, 0.15)
            task.delay(0.16, function()
                if Overlay and Overlay.Parent then Overlay:Destroy() end
            end)
        end
        XBtn.Activated:Connect(Close)
        Overlay.Activated:Connect(Close)

        Tween(Overlay, { BackgroundTransparency = 0.45 }, 0.18)
        Tween(CardScale, { Scale = 1 }, 0.2)

        return Overlay, Card, Close
    end

    -- Popup guide (dipakai AddGuide). data = { Title = "", Pages = { {Title=, Content=}, ... } }
    local function ShowGuide(data)
        local pages = data.Pages or {}
        if #pages == 0 then return end

        local _, Card, Close = OpenModal("GuideDialog", 440, 340)
        local multi = #pages > 1
        local footer = multi and 52 or 16
        local idx = 1

        local TitleLabel = Label(Card, {
            Text = "", Font = FONT_BOLD, TextSize = 15, RichText = true, ZIndex = 88,
            Position = UDim2.new(0, 18, 0, 14), Size = UDim2.new(1, -62, 0, 24),
        })
        New("Frame", {
            BackgroundColor3 = T.Track, BorderSizePixel = 0, ZIndex = 88,
            Position = UDim2.new(0, 14, 0, 46), Size = UDim2.new(1, -28, 0, 1),
        }, Card)

        local Scroll = New("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 88, Active = true,
            Position = UDim2.new(0, 14, 0, 54), Size = UDim2.new(1, -28, 1, -(54 + footer)),
            CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(110, 110, 110),
        }, Card)
        local Body = Label(Scroll, {
            Text = "", TextColor3 = Color3.fromRGB(215, 215, 215), TextSize = 12, TextWrapped = true,
            TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
            RichText = true, LineHeight = 1.15, ZIndex = 89,
            Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        })

        local PageLabel, Prev, Next
        if multi then
            local function MakeBtn(text, bg, fg)
                local b = New("TextButton", {
                    Text = text, Font = FONT_BOLD, TextSize = 12, TextColor3 = fg, BackgroundColor3 = bg,
                    BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 89, Size = UDim2.new(0, 86, 0, 30),
                }, Card)
                Corner(b, 10)
                return b
            end
            Prev = MakeBtn("Kembali", T.Control, T.Text)
            Prev.AnchorPoint = Vector2.new(0, 1)
            Prev.Position = UDim2.new(0, 14, 1, -12)

            Next = MakeBtn("Lanjut", T.Text, T.Dark)
            Next.AnchorPoint = Vector2.new(1, 1)
            Next.Position = UDim2.new(1, -14, 1, -12)

            PageLabel = Label(Card, {
                Text = "", TextColor3 = T.Sub, TextSize = 11, ZIndex = 89,
                TextXAlignment = Enum.TextXAlignment.Center,
                AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 80, 0, 16),
            })
        end

        local function Render()
            local pg = pages[idx]
            TitleLabel.Text = pg.Title or data.Title or "Guide"
            Body.Text = pg.Content or ""
            Scroll.CanvasPosition = Vector2.new(0, 0)
            if multi then
                PageLabel.Text = idx .. " / " .. #pages
                Prev.Visible = idx > 1
                Next.Text = (idx == #pages) and "Selesai" or "Lanjut"
            end
        end

        if multi then
            Prev.Activated:Connect(function()
                if idx > 1 then idx = idx - 1; Render() end
            end)
            Next.Activated:Connect(function()
                if idx < #pages then idx = idx + 1; Render() else Close() end
            end)
        end

        Render()
    end

