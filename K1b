            -- ------------------------------------------------
            function Items:AddParagraph(cfg)
                cfg = cfg or {}
                cfg.Title = cfg.Title or "Title"
                cfg.Content = cfg.Content or "Content"

                local row = NewRow(50, cfg)
                row.AutomaticSize = Enum.AutomaticSize.Y
