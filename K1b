                end

                -- Angka di kanan bisa diklik lalu diketik (Enter / klik di luar untuk menerapkan)
                local ValueLabel = New("TextBox", {
                    Text = "", Font = FONT, TextSize = 11, TextColor3 = T.Sub,
                    TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false,
                    BackgroundColor3 = T.Control, BackgroundTransparency = 1, BorderSizePixel = 0,
