local function ExecName()
    local ok,a,b=pcall(identifyexecutor)
    if ok and S(a) and a~="" then return S(b) and b~="" and a.." "..b or a end
    for _,n in ipairs({"getexecutorname","getexecutor"})do
        local f=_G[n]
        if T(f)then
            local ok2,x,y=pcall(f)
            if ok2 and S(x) and x~="" then return S(y) and y~="" and x.." "..y or x end
        end
    end
    return "Unknown"
end

local function Check(list)
