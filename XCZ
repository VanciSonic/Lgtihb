local function Score(t)
    local p,r=0,{}
    for _,x in ipairs(t)do
        local ok,v=Safe(x[2])
        local pass=ok and v==true
        if pass then p+=1 end
        r[#r+1]=x[1]..": "..(pass and"YES"or"NO")
    end
    return math.floor(p/#t*100+.5),p,#t,r
end

local function httpRequest(o)
    if type(syn)=="table"and T(syn.request)then return syn.request(o)end
    if T(request)then return request(o)end
    if T(http_request)then return http_request(o)end
    error("Tidak ada executor HTTP request yang tersedia")
end

