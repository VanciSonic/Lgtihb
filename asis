-- ============================================================
-- CLEAN TEXT (anti-markdown)
-- ============================================================
local function CleanText(text)
    if not text then return "" end

    text = text:gsub("```[^\n]*\n?", "")
    text = text:gsub("```", "")
    text = text:gsub("`([^`]*)`", "%1")

    text = text:gsub("\n#+%s*", "\n")
    text = text:gsub("^#+%s*", "")

    text = text:gsub("%*%*%*(.-)%*%*%*", "%1")
    text = text:gsub("%*%*(.-)%*%*", "%1")
    text = text:gsub("%*(.-)%*", "%1")
    text = text:gsub("%*", "")

    text = text:gsub("_(.-)_", "%1")

    text = text:gsub("\n%-%-%-+\n", "\n")
    text = text:gsub("^%-%-%-+", "")

    text = text:gsub("\n%- ", "\n• ")
    text = text:gsub("^%- ", "• ")

    text = text:gsub("\n%* ", "\n• ")
    text = text:gsub("^%* ", "• ")

    text = text:gsub("\n\n\n+", "\n\n")
    text = text:gsub("^\n+", "")
    text = text:gsub("\n+$", "")

    return text
end

