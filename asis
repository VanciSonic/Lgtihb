local unreadCount = 0

local function ShowNotification()
    unreadCount = unreadCount + 1

    BadgeLabel.Text = unreadCount > 99 and "99+" or tostring(unreadCount)

    -- Tampilkan badge dengan animasi pop
    if not Badge.Visible then
        Badge.Visible = true
        BadgeScale.Scale = 0
        TweenService:Create(
            BadgeScale,
            TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Scale = 1}
        ):Play()
    else
        -- Kalau badge udah ada, kasih efek pulse aja
        BadgeScale.Scale = 0.5
        TweenService:Create(
            BadgeScale,
            TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Scale = 1}
        ):Play()
    end

    -- Pulse ToggleBtn biar makin keliatan
    TweenService:Create(
        ToggleBtn,
        TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 52, 0, 52)}
    ):Play()
    task.wait(0.15)
    TweenService:Create(
        ToggleBtn,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 45, 0, 45)}
    ):Play()

    -- Main sound
    if NOTIF_SOUND and notifSound then
        notifSound:Play()
    end
end

local function ClearNotification()
    unreadCount = 0
    if Badge.Visible then
        local tween = TweenService:Create(
            BadgeScale,
            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            {Scale = 0}
        )
        tween:Play()
        tween.Completed:Connect(function()
            Badge.Visible = false
        end)
    end
end

