-- FUNGSI KIRIM PESAN KE AI (dengan notifikasi)
-- ============================================================
local isProcessing = false

-- Wrapper: CreateBubble + trigger notif kalau panel tertutup
local function CreateAIBubble(text)
    CreateBubble(text, false)

    -- Kalau panel sedang tertutup, tampilkan notifikasi
    if not isOpen then
        ShowNotification()
    end
end

local function AskAI(question)
    local req = (syn and syn.request) or request or http_request
        or (http and http.request) or (fluxus and fluxus.request)
    if not req then
        CreateAIBubble("❌ Executor tidak mendukung HTTP Request.")
        isProcessing = false
        return
    end

    local lastError = nil

    for idx, model in ipairs(AI_MODELS) do
        local success, result = pcall(function()
            return RequestModel(req, model, question)
        end)

        if success and result and result.StatusCode == 200 then
            local ok, data = pcall(function() return HttpService:JSONDecode(result.Body) end)
            if ok and data and data.choices and data.choices[1]
                and data.choices[1].message and data.choices[1].message.content then
                CreateAIBubble(data.choices[1].message.content)
                isProcessing = false
                return
            end
            lastError = "Data kosong"
        else
            lastError = result and result.StatusCode or "tidak ada respon"
            if result and result.StatusCode == 401 then
                break
            end
        end

        if idx < #AI_MODELS then
            task.wait(0.3)
        end
    end

    local statusStr = tostring(lastError)

    if statusStr == "429" then
        CreateAIBubble("⏳ LIMIT TERCAPAI!\n\nSemua model gratis sedang kena limit (50 req/hari).\n\nTunggu beberapa menit atau besok, lalu coba lagi.")
    elseif statusStr == "402" then
        CreateAIBubble("💸 KREDIT HABIS!\n\nModel butuh kredit berbayar. Pastikan pakai model dengan akhiran ':free'.")
    elseif statusStr == "401" then
        CreateAIBubble("🔑 API KEY SALAH!\n\nCek kembali API Key di bagian atas script. Pastikan tidak ada spasi atau karakter tambahan.")
    elseif statusStr == "404" then
        CreateAIBubble("⚠️ MODEL TIDAK DITEMUKAN!\n\nSemua model di daftar tidak tersedia. Ganti ke 'openrouter/free' atau cek di https://openrouter.ai/models")
    elseif statusStr == "502" or statusStr == "503" then
        CreateAIBubble("🔧 SERVER SEDANG DOWN!\n\nCoba lagi beberapa menit lagi.")
    else
        CreateAIBubble("❌ Gagal terhubung ke AI (Kode: " .. statusStr .. ").\n\nCoba lagi atau ganti model di daftar AI_MODELS.")
    end

    isProcessing = false
end

