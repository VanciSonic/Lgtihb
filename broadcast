        task.delay(math.max(duration, 0.1), function()
            if Holder and Holder.Parent then
                CloseBroadcast(Holder)
            end
        end)
    end
end

local function FetchBroadcast()
    local stamp = tostring(math.floor(os.clock() * 1000000))

    local urls = {
        BROADCAST_URL .. "?cb=" .. stamp,
        BROADCAST_URL .. "?t=" .. tostring(os.time()) .. "&x=" .. stamp
    }

    local req =
        (syn and syn.request)
        or (http and http.request)
        or request
        or (http_request)

    if req then
        for _, url in ipairs(urls) do
            local ok, response = pcall(function()
                return req({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["Cache-Control"] = "no-cache, no-store, max-age=0",
                        ["Pragma"] = "no-cache",
                        ["Expires"] = "0",
                        ["Accept"] = "application/json, text/plain, */*"
                    }
                })
            end)

            if ok and response then
                local code = tonumber(
                    response.StatusCode
                    or response.status_code
                    or 200
                )

                local body =
                    response.Body
                    or response.body

                if code >= 200
                and code < 300
                and body
                and body ~= "" then
                    return body
                end
            end
        end
    end

    local ok, body = pcall(function()
        return game:HttpGet(
            BROADCAST_URL .. "?cb=" .. stamp
        )
    end)

    if ok and body and body ~= "" then
        return body
    end

    return nil
end

local function CheckBroadcast()
    local Result = FetchBroadcast()

    if not Result then
        return
    end

    local DecodeSuccess, Data = pcall(function()
        return HttpService:JSONDecode(Result)
    end)

    if not DecodeSuccess or type(Data) ~= "table" then
        return
    end

    local text = tostring(Data.text or "")

    if text == "" then
        return
    end

    if text == LastBroadcastText then
        return
    end

    SaveLastBroadcast(text)
    ShowBroadcast(Data)
end

task.spawn(function()
    while _G.CyberBroadcastRunId == CyberBroadcastRunId do
        CheckBroadcast()
        task.wait(CHECK_INTERVAL)
    end
end)
