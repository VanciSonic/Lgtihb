local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local BROADCAST_URL = "https://raw.githubusercontent.com/VanciSonic/Lgtihb/main/textbc"
local CHECK_INTERVAL = 1
local BROADCAST_STATE_FILE = "CyberBroadcast_LastText.txt"

local LastBroadcastText = ""
local CurrentNotification = nil

_G.CyberBroadcastRunId = (_G.CyberBroadcastRunId or 0) + 1
local CyberBroadcastRunId = _G.CyberBroadcastRunId

pcall(function()
    if isfile and isfile(BROADCAST_STATE_FILE) then
        local saved = readfile(BROADCAST_STATE_FILE)

        if type(saved) == "string" then
            LastBroadcastText = saved
        end
    end
end)

pcall(function()
    local old = CoreGui:FindFirstChild("CyberBroadcast")

    if old then
        old:Destroy()
    end
end)

local BroadcastGui = Instance.new("ScreenGui")
BroadcastGui.Name = "CyberBroadcast"
BroadcastGui.ResetOnSpawn = false
BroadcastGui.IgnoreGuiInset = true
BroadcastGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
BroadcastGui.Parent = CoreGui

local function SaveLastBroadcast(text)
    LastBroadcastText = text

    pcall(function()
        if writefile then
            writefile(BROADCAST_STATE_FILE, text)
        end
    end)
end

local function CloseBroadcast(holder)
    if not holder or not holder.Parent then
        return
    end

    if holder:GetAttribute("Closing") then
        return
    end

    holder:SetAttribute("Closing", true)

    local move = TweenService:Create(
        holder,
        TweenInfo.new(
            0.42,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.In
        ),
        {
            Position = UDim2.new(0.5, 0, 0, -135),
            BackgroundTransparency = 1
        }
    )

    move:Play()

    for _, obj in ipairs(holder:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.22),
                {
                    TextTransparency = 1
                }
            ):Play()

        elseif obj:IsA("UIStroke") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.22),
                {
                    Transparency = 1
                }
            ):Play()

        elseif obj:IsA("Frame") then
            TweenService:Create(
                obj,
                TweenInfo.new(0.22),
                {
                    BackgroundTransparency = 1
                }
            ):Play()
        end
    end

    move.Completed:Wait()

    if holder and holder.Parent then
        holder:Destroy()
    end

    if CurrentNotification == holder then
        CurrentNotification = nil
    end
end

