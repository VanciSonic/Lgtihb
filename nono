--============================================================
-- CLOSE ANIMATION
--============================================================

local function ClosePopup()
    TweenService:Create(Overlay, TweenInfo.new(0.2), {
        BackgroundTransparency = 1
    }):Play()

    local Close = TweenService:Create(
        Main,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {
            Size = UDim2.fromOffset(390, 205),
            BackgroundTransparency = 1
        }
    )

    for _, obj in ipairs({
        Warning,
        LowExecutor,
        Message,
        Continue,
        Change
    }) do
        TweenService:Create(obj, TweenInfo.new(0.15), {
            TextTransparency = 1
        }):Play()
    end

    Close:Play()

    task.delay(0.32, function()
        ScreenGui:Destroy()
    end)
end


Continue.MouseButton1Click:Connect(function()
    ClosePopup()

